+/// Derive declarations from configured software, not a fixed Chrome persona.
+fn software_client_hints(ua: &str, platform_override: Option<&str>) -> (String, String) {
+    fn product_token(token: &str) -> Option<(&str, &str)> {
+        let (product, suffix) = token.split_once('/')?;
+        if !product.as_bytes().first()?.is_ascii_alphabetic()
+            || !product.bytes().all(|b| b.is_ascii_alphanumeric() || b".+-".contains(&b))
+            || !suffix.as_bytes().first()?.is_ascii_digit() { return None; }
+        let length = suffix.bytes().take_while(|b| b.is_ascii_alphanumeric() || b".+-".contains(b)).count();
+        Some((product, &suffix[..length]))
+    }
+    let product_version = ["Obscura", "Lightpanda", "Edg", "OPR", "Chrome", "Chromium", "Firefox"]
+        .into_iter().find_map(|product| {
+            ua.split_ascii_whitespace().filter_map(product_token).find(|(name, _)| *name == product)
+        }).or_else(|| {
+            let (product, version) = product_token(ua.split_ascii_whitespace().next()?)?;
+            (product != "Mozilla").then_some((product, version))
+        });
+    let quote = |value: &str| format!("\"{}\"", value.replace('\\', "\\\\").replace('"', "\\\""));
+    let brands = if let Some((product, version)) = product_version {
+        let chromium_version = ua.split_ascii_whitespace().filter_map(product_token)
+            .find(|(name, _)| matches!(*name, "Chrome" | "Chromium")).map(|(_, version)| version);
+        let (names, count) = match product {
+            "Chrome" => (["Chromium", "Google Chrome"], 2),
+            "Edg" => (["Chromium", "Microsoft Edge"], 2),
+            "OPR" => (["Chromium", "Opera"], 2),
+            _ => ([product, ""], 1),
+        };
+        names[..count].iter().map(|name| {
+            let version = if *name == "Chromium" { chromium_version.unwrap_or(version) } else { version };
+            format!("{};v={}", quote(name), quote(version.split('.').next().unwrap_or("")))
+        }).collect::<Vec<_>>().join(", ")
+    } else { String::new() };
+    let platform = match platform_override.unwrap_or("") {
+        "Win32" | "Win64" | "Windows" => "Windows",
+        "MacIntel" | "MacPPC" | "macOS" => "macOS",
+        value if value.starts_with("Linux") => "Linux",
+        "" => if ua.contains("Windows NT") { "Windows" } else if ua.contains("Macintosh") { "macOS" } else if ua.contains("Linux") { "Linux" } else { "" },
+        value => value,
     };
-    (sec_ch_ua, platform.to_string())
+    (brands, quote(platform))
 }
 
