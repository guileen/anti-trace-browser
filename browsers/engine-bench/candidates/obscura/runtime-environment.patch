+                "redispatchedMessageTrusted": false, "retainedMessageTrusted": false,
+                "upgradeTrusted": true, "upgradeClass": true, "idbCallerPrivate": true,
+                "openTrusted": true, "successClass": true, "redispatchedIdbTrusted": false,
