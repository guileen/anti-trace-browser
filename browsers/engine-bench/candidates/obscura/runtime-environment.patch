+fn watch_parent_eof(shutdown: Arc<AtomicBool>, notify: Arc<Notify>) -> std::io::Result<()> {
+    if std::env::var("ANTI_TRACE_PARENT_EOF").as_deref() != Ok("1") { return Ok(()); }
+    std::thread::Builder::new().name("obscura-parent-eof".into()).spawn(move || {
