+// Original resource bytes are serialized only when the document/revision differs.
+// Merely observing metadata must never mutate rendering or issue a request.
+fn getSiteIcon(cmd: *CDP.Command) !void {
+    const Params = struct { knownDocument: ?[]const u8 = null, knownRevision: ?u64 = null };
+    const params = try cmd.params(Params) orelse Params{};
+    const bc = cmd.browser_context orelse return error.BrowserContextNotLoaded;
+    const frame = bc.mainFrame() orelse return error.FrameNotLoaded;
+    const icon = &frame._site_icon;
+    const document = id.toLoaderId(frame._loader_id);
+    if (params.knownDocument != null and params.knownRevision == icon.revision and
+        std.mem.eql(u8, params.knownDocument.?, &document))
+    {
+        return cmd.sendResult(.{ .documentId = &document, .revision = icon.revision, .unchanged = true }, .{});
+    }
+    const ready = icon.status == .ready;
+    const data: ?[]const u8 = if (ready) blk: {
+        const codec = std.base64.standard.Encoder;
+        const encoded = try frame.call_arena.alloc(u8, codec.calcSize(icon.bytes.len));
+        break :blk codec.encode(encoded, icon.bytes);
+    } else null;
+    return cmd.sendResult(.{
+        .documentId = &document,
+        .revision = icon.revision,
+        .state = @tagName(icon.status),
+        .sha256 = if (ready) @as(?[]const u8, &icon.digest) else null,
+        .mime = if (ready) @as(?[]const u8, icon.mime) else null,
+        .data = data,
+    }, .{});
+}
