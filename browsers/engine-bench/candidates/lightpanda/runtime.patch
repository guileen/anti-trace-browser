+        .state = "ready",
+        .mime = "image/png",
+        .sha256 = "f071d5a85a4d70c825fe3b3d78e72ff337e77a1dc576de67fd897aef0c286b85",
+        .data = "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mPQKDryHwAEggJefd/xlgAAAABJRU5ErkJggg==",
+    }, .{ .id = 401 });
+    try ctx.processMessage(.{ .id = 402, .method = "Page.getSiteIcon", .sessionId = "SID-X", .params = .{
+        .knownDocument = &document,
+        .knownRevision = revision,
+    } });
+    try ctx.expectSentResult(.{ .documentId = &document, .revision = revision, .unchanged = true }, .{ .id = 402 });
+    try testing.expectEqual(revision, icon.revision);
+    // Assigning the same URL must not restart even a no-store resource request.
+    try ctx.processMessage(.{ .id = 403, .method = "Runtime.evaluate", .sessionId = "SID-X", .params = .{
+        .expression = "document.querySelector('#site-icon').setAttribute('href','/images/site-icon.png')",
+    } });
+    try testing.waitForPage(bc);
+    try testing.expectEqual(revision, icon.revision);
+
+    try ctx.processMessage(.{ .id = 410, .method = "Runtime.evaluate", .sessionId = "SID-X", .params = .{
+        .expression = "document.querySelector('#site-icon').href = '/images/no-such-site-icon.png'",
