+    try testing.expectEqualSlices(u8, fixtures.site_icon_png, icon.bytes);
+    try ctx.processMessage(.{ .id = 411, .method = "Runtime.evaluate", .sessionId = "SID-X", .params = .{
+        .expression = "document.querySelector('#site-icon').rel = 'alternate'",
