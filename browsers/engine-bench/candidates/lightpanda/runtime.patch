+}
+pub const Metrics = extern struct {
+    x: f64 = 0,
+    y: f64 = 0,
+    width: f64 = 0,
+    height: f64 = 0,
+    client_width: f64 = 0,
+    client_height: f64 = 0,
+    scroll_width: f64 = 0,
+    scroll_height: f64 = 0,
+    scroll_x: f64 = 0,
+    scroll_y: f64 = 0,
+    max_x: f64 = 0,
+    max_y: f64 = 0,
+    border_left: f64 = 0,
+    border_top: f64 = 0,
