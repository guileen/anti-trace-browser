diff --git a/src/Identity.zig b/src/Identity.zig
new file mode 100644
index 0000000..22523ec
--- /dev/null
+++ b/src/Identity.zig
@@ -0,0 +1,165 @@
+// One native declaration shared by HTTP, Window and Worker. Custom UA metadata
+// describes the configured declaration, not an assertion of Chrome equivalence.
+const std = @import("std");
+const builtin = @import("builtin");
+const Allocator = std.mem.Allocator;
+const Identity = @This();
+
+pub const Brand = struct { brand: []const u8, version: []const u8 };
+pub const default_user_agent = "Lightpanda/" ++ @import("lightpanda").build_config.version;
+
+user_agent: [:0]const u8,
+brands: [1]Brand,
+full_version_list: [1]Brand,
+platform: []const u8,
+navigator_platform: []const u8,
+mobile: bool,
+architecture: []const u8,
+bitness: []const u8,
+wow64: bool,
+sec_ch_ua: [:0]const u8,
+sec_ch_ua_full_version_list: [:0]const u8,
+sec_ch_ua_platform: [:0]const u8,
+
+pub fn init(allocator: Allocator, ua: []const u8, configured_platform: ?[]const u8) !Identity {
+    try @import("Config.zig").validateUserAgent(ua);
+    const owned = try allocator.dupeSentinel(u8, ua, 0);
+    errdefer allocator.free(owned);
+    const product = parseProduct(owned) orelse return error.invalid_config;
+    const major = product.version[0 .. std.mem.findScalar(u8, product.version, '.') orelse product.version.len];
+    const declared_platform = platformFromUA(owned);
+    const navigator_platform = try allocator.dupe(u8, configured_platform orelse declared_platform orelse hostPlatform());
+    errdefer allocator.free(navigator_platform);
+    const platform = platformName(navigator_platform) orelse return error.invalid_config;
+    if (declared_platform) |declared| {
+        if (!std.mem.eql(u8, platform, platformName(declared).?)) return error.invalid_config;
+    }
+    const low = try allocator.printSentinel("\"{s}\";v=\"{s}\"", .{ product.brand, major }, 0);
+    errdefer allocator.free(low);
+    const full = try allocator.printSentinel("\"{s}\";v=\"{s}\"", .{ product.brand, product.version }, 0);
+    errdefer allocator.free(full);
+    const wire_platform = try allocator.printSentinel("\"{s}\"", .{platform}, 0);
+    const arm = std.mem.find(u8, owned, "aarch64") != null or std.mem.find(u8, owned, "arm64") != null or std.mem.find(u8, owned, "ARM") != null;
+    const wow64 = std.mem.find(u8, owned, "WOW64") != null;
+    const x86 = wow64 or std.mem.find(u8, owned, "x86") != null or std.mem.find(u8, owned, "x64") != null or std.mem.find(u8, owned, "Win64") != null or std.mem.find(u8, owned, "Intel") != null;
+    return .{
+        .user_agent = owned,
+        .brands = .{.{ .brand = product.brand, .version = major }},
+        .full_version_list = .{.{ .brand = product.brand, .version = product.version }},
+        .platform = platform,
+        .navigator_platform = navigator_platform,
+        .mobile = std.mem.find(u8, owned, "Mobile") != null or std.mem.eql(u8, platform, "Android") or std.mem.eql(u8, platform, "iOS"),
+        .architecture = if (arm) "arm" else if (x86) "x86" else if (declared_platform != null) "" else hostArchitecture(),
+        .bitness = if (arm or x86) (if (std.mem.find(u8, owned, "64") != null or std.mem.find(u8, owned, "Intel Mac") != null) "64" else "32") else if (declared_platform != null) "" else hostBitness(),
+        .wow64 = wow64,
+        .sec_ch_ua = low,
+        .sec_ch_ua_full_version_list = full,
+        .sec_ch_ua_platform = wire_platform,
+    };
+}
+
+pub fn deinit(self: *const Identity, allocator: Allocator) void {
+    allocator.free(self.sec_ch_ua_platform);
+    allocator.free(self.sec_ch_ua_full_version_list);
+    allocator.free(self.sec_ch_ua);
+    allocator.free(self.navigator_platform);
+    allocator.free(self.user_agent);
+}
+
+const Product = struct { brand: []const u8, version: []const u8 };
+fn parseProduct(ua: []const u8) ?Product {
+    // Compatibility tokens (Mozilla/AppleWebKit) are not the selected browser.
+    const known = [_]struct { token: []const u8, brand: []const u8 }{
+        .{ .token = "Edg/", .brand = "Microsoft Edge" },
+        .{ .token = "OPR/", .brand = "Opera" },
+        .{ .token = "Lightpanda/", .brand = "Lightpanda" },
+        .{ .token = "Chrome/", .brand = "Google Chrome" },
+        .{ .token = "Chromium/", .brand = "Chromium" },
+        .{ .token = "Firefox/", .brand = "Firefox" },
+        .{ .token = "Version/", .brand = "Safari" },
+    };
+    for (known) |candidate| {
+        if (std.mem.eql(u8, candidate.token, "Version/") and std.mem.find(u8, ua, "Safari/") == null) continue;
+        if (std.mem.find(u8, ua, candidate.token)) |start| {
+            if (start > 0 and ua[start - 1] != ' ' and ua[start - 1] != ')') continue;
+            const rest = ua[start + candidate.token.len ..];
+            const version = rest[0 .. std.mem.findAny(u8, rest, " ;)\t") orelse rest.len];
+            if (!safeToken(version)) return null;
+            return .{ .brand = candidate.brand, .version = version };
+        }
+    }
+    var tokens = std.mem.tokenizeScalar(u8, ua, ' ');
+    const first = tokens.next() orelse return null;
+    const slash = std.mem.findScalar(u8, first, '/') orelse first.len;
+    const brand = first[0..slash];
+    const version = if (slash < first.len) first[slash + 1 ..] else "";
+    if (!safeToken(brand) or (slash < first.len and !safeToken(version))) return null;
+    return .{ .brand = brand, .version = version };
+}
+fn safeToken(value: []const u8) bool {
+    if (value.len == 0) return false;
+    for (value) |c| if (!(std.ascii.isAlphanumeric(c) or c == '.' or c == '-' or c == '_' or c == '+')) return false;
+    return true;
+}
+fn platformFromUA(ua: []const u8) ?[]const u8 {
+    if (std.mem.find(u8, ua, "Android") != null) return "Android";
+    if (std.mem.find(u8, ua, "iPhone") != null) return "iPhone";
+    if (std.mem.find(u8, ua, "iPad") != null) return "iPad";
+    if (std.mem.find(u8, ua, "Windows") != null) return "Win32";
+    if (std.mem.find(u8, ua, "Macintosh") != null or std.mem.find(u8, ua, "Mac OS X") != null) return "MacIntel";
+    if (std.mem.find(u8, ua, "Linux") != null) return if (std.mem.find(u8, ua, "aarch64") != null) "Linux aarch64" else "Linux x86_64";
+    if (std.mem.find(u8, ua, "FreeBSD") != null) return "FreeBSD";
+    return null;
+}
+fn platformName(platform: []const u8) ?[]const u8 {
+    if (std.mem.startsWith(u8, platform, "Mac")) return "macOS";
+    if (std.mem.startsWith(u8, platform, "Win")) return "Windows";
+    if (std.mem.startsWith(u8, platform, "Linux")) return "Linux";
+    if (std.mem.eql(u8, platform, "Android")) return "Android";
+    if (std.mem.eql(u8, platform, "iPhone") or std.mem.eql(u8, platform, "iPad")) return "iOS";
+    if (std.mem.eql(u8, platform, "FreeBSD")) return "FreeBSD";
+    if (std.mem.eql(u8, platform, "Unknown")) return "Unknown";
+    return null;
+}
+fn hostPlatform() []const u8 {
+    return switch (builtin.target.os.tag) {
+        .macos => "MacIntel",
+        .windows => "Win32",
+        .linux => if (builtin.target.cpu.arch == .aarch64) "Linux aarch64" else "Linux x86_64",
+        .freebsd => "FreeBSD",
+        else => "Unknown",
+    };
+}
+fn hostArchitecture() []const u8 {
+    return switch (builtin.target.cpu.arch) {
+        .x86, .x86_64 => "x86",
+        .aarch64, .aarch64_be, .arm, .armeb => "arm",
+        else => "",
+    };
+}
+fn hostBitness() []const u8 {
+    return switch (builtin.target.cpu.arch) {
+        .x86_64, .aarch64, .aarch64_be, .powerpc64, .powerpc64le, .riscv64 => "64",
+        else => "32",
+    };
+}
+
+test "Identity: native and explicit UA share low/full brands and wire declarations" {
+    const allocator = std.testing.allocator;
+    var native = try Identity.init(allocator, default_user_agent, null);
+    defer native.deinit(allocator);
+    try std.testing.expectEqualStrings("Lightpanda", native.brands[0].brand);
+    try std.testing.expectEqualStrings("1", native.brands[0].version);
+    var chrome = try Identity.init(allocator, "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/124.0.0.0 Safari/537.36", "Win32");
+    defer chrome.deinit(allocator);
+    try std.testing.expectEqualStrings("Google Chrome", chrome.brands[0].brand);
+    try std.testing.expectEqualStrings("124", chrome.brands[0].version);
+    try std.testing.expectEqualStrings("124.0.0.0", chrome.full_version_list[0].version);
+    try std.testing.expectEqualStrings("\"Google Chrome\";v=\"124\"", chrome.sec_ch_ua);
+    try std.testing.expectEqualStrings("Windows", chrome.platform);
+    try std.testing.expectError(error.invalid_config, Identity.init(allocator, "Chrome/124.0 (Windows NT 10.0)", "MacIntel"));
+    var custom = try Identity.init(allocator, "CustomBot/2.7", null);
+    defer custom.deinit(allocator);
+    try std.testing.expectEqualStrings("CustomBot", custom.brands[0].brand);
+    try std.testing.expectEqualStrings("2", custom.brands[0].version);
+}
diff --git a/src/browser/frame/site_icon.zig b/src/browser/frame/site_icon.zig
new file mode 100644
index 0000000..b36772c
--- /dev/null
+++ b/src/browser/frame/site_icon.zig
@@ -0,0 +1,191 @@
+// Browser document resource metadata. No desktop/UI ownership lives here.
+const std = @import("std");
+const Frame = @import("../Frame.zig");
+const Element = @import("../webapi/Element.zig");
+const URL = @import("../URL.zig");
+const HttpClient = @import("../../network/HttpClient.zig");
+const dimensions = @import("../image_dimensions.zig");
+
+pub const max_bytes = 512 * 1024;
+pub const State = struct {
+    source: ?*Element.Html.Link = null,
+    href: []const u8 = "",
+    revision: u64 = 0,
+    status: enum { missing, loading, ready, failed, unsupported } = .missing,
+    bytes: []const u8 = "",
+    mime: []const u8 = "",
+    digest: [64]u8 = @splat('0'),
+
+    pub fn deinit(self: *State, allocator: std.mem.Allocator) void {
+        if (self.bytes.len != 0) allocator.free(self.bytes);
+        self.href = "";
+        self.bytes = "";
+    }
+};
+
+pub fn hasIconRel(rel: []const u8) bool {
+    var tokens = std.mem.tokenizeAny(u8, rel, " \t\r\n\x0c");
+    while (tokens.next()) |token| {
+        if (std.ascii.eqlIgnoreCase(token, "icon")) return true;
+    }
+    return false;
+}
+
+fn changed(frame: *Frame) void {
+    frame._site_icon.revision +%= 1;
+    frame._session.notification.dispatch(.frame_site_icon_changed, frame);
+}
+
+pub fn disconnected(frame: *Frame, link: *Element.Html.Link) void {
+    if (frame._site_icon.source != link) return;
+    const revision = frame._site_icon.revision;
+    frame._site_icon.deinit(frame._session.browser.allocator);
+    frame._site_icon = .{ .revision = revision };
+    changed(frame);
+}
+
+pub fn linkChanged(frame: *Frame, link: *Element.Html.Link) !void {
+    if (frame.parent != null or frame._parse_mode == .fragment or frame.isGoingAway()) return;
+    const element = link.asElement();
+    if (element.getDocument(frame) != frame.document) return;
+    const href = element.getAttributeInterned("href") orelse "";
+    if (!hasIconRel(element.getAttributeInterned("rel") orelse "") or href.len == 0) {
+        disconnected(frame, link);
+        return;
+    }
+    const state = &frame._site_icon;
+    // Parser completion, relList reflection and metadata reads must not restart
+    // an unchanged request (including failed and unsupported outcomes).
+    if (state.source == link and std.mem.eql(u8, state.href, href)) return;
+    const allocator = frame._session.browser.allocator;
+    const revision = state.revision;
+    state.deinit(allocator);
+    state.* = .{ .source = link, .href = href, .revision = revision, .status = .loading };
+    changed(frame);
+    errdefer {
+        state.status = .failed;
+        changed(frame);
+    }
+    if (href.len > max_bytes * 3) return error.IconTooLarge;
+    const arena = try frame._session.getArena(.small, "site_icon");
+    defer arena.release();
+    const resolved = try URL.resolve(arena.allocator(), frame.base(), href, .{ .encoding = frame.charset });
+    const load = try frame._factory.create(Load{ .frame = frame, .revision = state.revision });
+    errdefer frame._factory.destroy(load);
+    const transfer = try frame._session.browser.http_client.newRequest(.{
+        .ctx = load,
+        .url = resolved,
+        .method = .GET,
+        .origin = frame.origin,
+        .request_mode = .no_cors,
+        .credentials_mode = .include,
+        .resource_type = .image,
+        .header_callback = Load.header,
+        .data_callback = Load.data,
+        .done_callback = Load.done,
+        .error_callback = Load.failed,
+        .shutdown_callback = Load.shutdown,
+    }, &frame._http_owner);
+    {
+        errdefer transfer.deinit();
+        try transfer.setHeader("Accept", "image/png,image/x-icon,image/vnd.microsoft.icon,image/*;q=0.8,*/*;q=0.5", .{});
+        try frame.headersForRequest(transfer, .{});
+    }
+    // HttpClient owns synthetic data:/blob: handling as well as proxy, cookies,
+    // referrer and Network.* events. submit failure already calls failed().
+    transfer.submit() catch {};
+}
+
+const Load = struct {
+    frame: *Frame,
+    revision: u64,
+    status: u16 = 0,
+    bytes: std.ArrayList(u8) = .empty,
+
+    fn current(self: *const Load) bool {
+        return !self.frame.isGoingAway() and self.frame._site_icon.revision == self.revision;
+    }
+    fn header(transfer: *HttpClient.Transfer) !HttpClient.Transfer.HeaderResult {
+        const self: *Load = @ptrCast(@alignCast(transfer.req.ctx));
+        self.status = transfer.responseStatus() orelse 0;
+        if (!self.current()) return error.StaleIcon;
+        if (transfer.getContentLength()) |size| {
+            if (size > max_bytes) return error.IconTooLarge;
+        }
+        return .proceed;
+    }
+    fn data(transfer: *HttpClient.Transfer, chunk: []const u8) !void {
+        const self: *Load = @ptrCast(@alignCast(transfer.req.ctx));
+        if (!self.current()) return error.StaleIcon;
+        if (chunk.len > max_bytes - self.bytes.items.len) return error.IconTooLarge;
+        try self.bytes.appendSlice(self.frame._session.browser.allocator, chunk);
+    }
+    fn done(ctx: *anyopaque) !void {
+        const self: *Load = @ptrCast(@alignCast(ctx));
+        defer self.destroy();
+        if (!self.current()) return;
+        const state = &self.frame._site_icon;
+        if (self.status < 200 or self.status >= 300 or self.bytes.items.len == 0) {
+            state.status = .failed;
+        } else if (imageMime(self.bytes.items)) |mime| {
+            state.bytes = self.bytes.toOwnedSlice(self.frame._session.browser.allocator) catch {
+                state.status = .failed;
+                changed(self.frame);
+                return;
+            };
+            state.mime = mime;
+            var digest: [32]u8 = undefined;
+            std.crypto.hash.sha2.Sha256.hash(state.bytes, &digest, .{});
+            state.digest = std.fmt.bytesToHex(digest, .lower);
+            state.status = .ready;
+        } else {
+            state.status = .unsupported;
+        }
+        changed(self.frame);
+    }
+    fn failed(ctx: *anyopaque, _: anyerror) void {
+        const self: *Load = @ptrCast(@alignCast(ctx));
+        if (self.current()) {
+            self.frame._site_icon.status = .failed;
+            changed(self.frame);
+        }
+        self.destroy();
+    }
+    fn shutdown(ctx: *anyopaque) void {
+        const self: *Load = @ptrCast(@alignCast(ctx));
+        self.destroy();
+    }
+    fn destroy(self: *Load) void {
+        self.bytes.deinit(self.frame._session.browser.allocator);
+        self.frame._factory.destroy(self);
+    }
+};
+
+fn imageMime(bytes: []const u8) ?[]const u8 {
+    if (bytes.len >= 24 and std.mem.startsWith(u8, bytes, "\x89PNG\r\n\x1a\n")) {
+        const size = dimensions.parse(bytes) orelse return null;
+        if (size.width > 4096 or size.height > 4096) return null;
+        return "image/png";
+    }
+    if (bytes.len >= 22 and std.mem.eql(u8, bytes[0..4], "\x00\x00\x01\x00")) {
+        const count = std.mem.readInt(u16, bytes[4..6], .little);
+        if (count == 0 or count > 256 or 6 + @as(usize, count) * 16 > bytes.len) return null;
+        var index: usize = 0;
+        while (index < count) : (index += 1) {
+            const entry = bytes[6 + index * 16 ..][0..16];
+            const size: usize = std.mem.readInt(u32, entry[8..12], .little);
+            const offset: usize = std.mem.readInt(u32, entry[12..16], .little);
+            if (size == 0 or offset < 6 + @as(usize, count) * 16 or offset > bytes.len or size > bytes.len - offset) return null;
+        }
+        return "image/x-icon";
+    }
+    return null;
+}
+
+test "site icon relation tokens and bounded format identification" {
+    try std.testing.expect(hasIconRel("shortcut\tICON"));
+    try std.testing.expect(!hasIconRel("apple-touch-icon iconography"));
+    try std.testing.expect(imageMime("not an icon") == null);
+    const malformed_ico = [6]u8{ 0, 0, 1, 0, 1, 0 } ++ @as([16]u8, @splat(0));
+    try std.testing.expect(imageMime(&malformed_ico) == null);
+}
diff --git a/src/browser/graphics_bytes.zig b/src/browser/graphics_bytes.zig
new file mode 100644
index 0000000..3964c9b
--- /dev/null
+++ b/src/browser/graphics_bytes.zig
@@ -0,0 +1,11 @@
+const std = @import("std");
+/// Binary buffers are numeric arrays at the native graphics JSON boundary,
+/// never UTF-8 strings (arbitrary RGBA and typed-array bytes need not be UTF-8).
+pub const Bytes = struct {
+    data: []const u8,
+    pub fn jsonStringify(self: Bytes, writer: *std.json.Stringify) !void {
+        try writer.beginArray();
+        for (self.data) |byte| try writer.write(byte);
+        try writer.endArray();
+    }
+};
diff --git a/src/browser/native_environment.zig b/src/browser/native_environment.zig
new file mode 100644
index 0000000..eec588e
--- /dev/null
+++ b/src/browser/native_environment.zig
@@ -0,0 +1,166 @@
+// Native profile identity is committed only after configuration, assets and storage restore.
+const std = @import("std");
+const lp = @import("lightpanda");
+const Persistence = @import("webapi/storage/Persistence.zig");
+const Sqlite = @import("../storage/sqlite/Sqlite.zig");
+
+const KeyOrder = struct {
+    keys: []const []const u8,
+
+    pub fn lessThan(self: KeyOrder, a: usize, b: usize) bool {
+        return std.mem.lessThan(u8, self.keys[a], self.keys[b]);
+    }
+};
+
+fn sortValue(value: *std.json.Value) void {
+    switch (value.*) {
+        .object => |*object| {
+            object.sortUnstable(KeyOrder{ .keys = object.keys() });
+            for (object.values()) |*child| sortValue(child);
+        },
+        .array => |*array| {
+            for (array.items) |*child| sortValue(child);
+        },
+        else => {},
+    }
+}
+
+fn sha256(bytes: []const u8) [64]u8 {
+    var digest: [32]u8 = undefined;
+    std.crypto.hash.sha2.Sha256.hash(bytes, &digest, .{});
+    return std.fmt.bytesToHex(digest, .lower);
+}
+
+fn isSha256(value: []const u8) bool {
+    if (value.len != 64) return false;
+    for (value) |c| {
+        if ((c < '0' or c > '9') and (c < 'a' or c > 'f')) return false;
+    }
+    return true;
+}
+
+// Return whether the durable record needs updating. Every check happens before
+// any update, under the same IMMEDIATE transaction as the eventual commit.
+fn admitExisting(conn: Sqlite.Conn, environment: *const lp.Config.Environment, semantic: []const u8, raw: []const u8) !bool {
+    const count = conn.scalar(i64, "select count(*) from environment", .{}) catch |err| switch (err) {
+        error.Error => return error.incompatible_profile,
+        else => return err,
+    };
+    if (count != 1) return error.incompatible_profile;
+    const row = (conn.row(
+        \\select schema,id,revision,semantic_sha256,raw_sha256 from environment
+        \\where singleton=1 and typeof(singleton)='integer' and typeof(schema)='integer'
+        \\and typeof(id)='text' and length(id)>0 and typeof(revision)='integer'
+        \\and revision between 1 and 4294967295
+        \\and typeof(semantic_sha256)='text' and typeof(raw_sha256)='text'
+    , .{}) catch |err| switch (err) {
+        error.Error => return error.incompatible_profile,
+        else => return err,
+    }) orelse return error.incompatible_profile;
+    defer row.deinit();
+
+    const schema = row.get(i64, 0);
+    const id = row.get([]const u8, 1);
+    const revision = row.get(i64, 2);
+    const old_semantic = row.get([]const u8, 3);
+    const old_raw = row.get([]const u8, 4);
+    if (schema != 3 or !isSha256(old_semantic) or !isSha256(old_raw)) return error.incompatible_profile;
+    if (!std.mem.eql(u8, id, environment.id)) return error.identity_collision;
+    if (environment.revision < revision) return error.incompatible_profile;
+    if (environment.revision == revision) {
+        if (!std.mem.eql(u8, old_semantic, semantic)) return error.incompatible_profile;
+    } else {
+        if (@as(i64, environment.revision) != revision + 1) return error.incompatible_profile;
+        const previous = environment.previous_environment_sha256 orelse return error.incompatible_profile;
+        if (!std.mem.eql(u8, previous, old_raw)) return error.incompatible_profile;
+    }
+    return environment.revision != revision or !std.mem.eql(u8, old_raw, raw);
+}
+
+/// Called by App after asset validation and Session.preflightStorage, before
+/// publishing ready/getInfo. No configuration is generated or rewritten here.
+pub fn admit(allocator: std.mem.Allocator, config: *const lp.Config, raw: []const u8) !void {
+    const environment = if (config.environment) |*value| value else return error.invalid_config;
+    if (environment.schema != 3 or environment.id.len == 0 or environment.revision == 0) return error.invalid_config;
+
+    // Preserve the host's exact JSON number spellings: parsing through f64
+    // would change e.g. 1.0 to 1 and invalidate the resolved digest.
+    var parsed = std.json.parseFromSlice(std.json.Value, allocator, raw, .{ .parse_numbers = false }) catch |err| switch (err) {
+        error.OutOfMemory => return err,
+        else => return error.invalid_config,
+    };
+    defer parsed.deinit();
+    if (parsed.value != .object) return error.invalid_config;
+    sortValue(&parsed.value);
+    const root = &parsed.value.object;
+    var canonical: std.Io.Writer.Allocating = .init(allocator);
+    defer canonical.deinit();
+    if (environment.resolved_sha256) |expected| {
+        if (!isSha256(expected)) return error.invalid_config;
+        const resolved = root.get("resolved") orelse return error.invalid_config;
+        if (resolved != .object) return error.invalid_config;
+        std.json.Stringify.value(resolved, .{}, &canonical.writer) catch return error.OutOfMemory;
+        const actual = sha256(canonical.written());
+        if (!std.mem.eql(u8, expected, &actual)) return error.incompatible_profile;
+        canonical.clearRetainingCapacity();
+    }
+
+    // Management proofs and physical relocations are not a new identity.
+    for ([_][]const u8{ "name", "mode", "created_at", "revision", "resolved_sha256", "previous_environment_sha256", "asset_paths" }) |key| {
+        _ = root.orderedRemove(key);
+    }
+    const storage = root.getPtr("storage") orelse return error.invalid_config;
+    if (storage.* != .object) return error.invalid_config;
+    _ = storage.object.orderedRemove("path");
+    const runtime = root.getPtr("runtime") orelse return error.invalid_config;
+    if (runtime.* != .object) return error.invalid_config;
+    _ = runtime.object.orderedRemove("binary");
+    std.json.Stringify.value(parsed.value, .{}, &canonical.writer) catch return error.OutOfMemory;
+    const semantic_digest = sha256(canonical.written());
+    const raw_digest = sha256(raw);
+
+    const path = try allocator.printSentinel("{s}/environment.sqlite", .{environment.storage.path}, 0);
+    defer allocator.free(path);
+    // Lost admission metadata must not be silently regenerated over its WAL.
+    if (std.Io.Dir.cwd().statFile(lp.io, path, .{})) |_| {} else |err| switch (err) {
+        error.FileNotFound => {
+            const dir = try std.Io.Dir.cwd().openDir(lp.io, environment.storage.path, .{});
+            defer dir.close(lp.io);
+            for ([_][]const u8{ "environment.sqlite-wal", "environment.sqlite-shm", "environment.sqlite-journal" }) |name| {
+                if (dir.statFile(lp.io, name, .{})) |_| {
+                    return error.incompatible_profile;
+                } else |recovery_err| switch (recovery_err) {
+                    error.FileNotFound => {},
+                    else => return recovery_err,
+                }
+            }
+        },
+        else => return err,
+    }
+    const opened = try Persistence.open(path);
+    const conn = opened.conn;
+    defer conn.close();
+    try conn.begin(.immediate);
+    errdefer conn.rollback() catch {};
+    if (opened.existing) {
+        if (try admitExisting(conn, environment, &semantic_digest, &raw_digest)) {
+            try conn.exec("update environment set schema=?1,id=?2,revision=?3,semantic_sha256=?4,raw_sha256=?5 where singleton=1", .{
+                environment.schema, environment.id, environment.revision, @as([]const u8, &semantic_digest), @as([]const u8, &raw_digest),
+            });
+        }
+    } else {
+        try conn.exec(
+            \\create table environment (
+            \\ singleton integer primary key check(singleton=1),
+            \\ schema integer not null check(schema=3), id text not null check(length(id)>0),
+            \\ revision integer not null check(revision>=1),
+            \\ semantic_sha256 text not null check(length(semantic_sha256)=64),
+            \\ raw_sha256 text not null check(length(raw_sha256)=64)
+            \\) strict
+        , .{});
+        try conn.exec("insert into environment(singleton,schema,id,revision,semantic_sha256,raw_sha256) values(1,?1,?2,?3,?4,?5)", .{
+            environment.schema, environment.id, environment.revision, @as([]const u8, &semantic_digest), @as([]const u8, &raw_digest),
+        });
+    }
+    try conn.commit();
+}
diff --git a/src/browser/native_layout.zig b/src/browser/native_layout.zig
new file mode 100644
index 0000000..b3e5d30
--- /dev/null
+++ b/src/browser/native_layout.zig
@@ -0,0 +1,454 @@
+const std = @import("std");
+const lp = @import("lightpanda");
+const Frame = @import("Frame.zig");
+const Node = @import("webapi/Node.zig");
+const Element = @import("webapi/Element.zig");
+const DOMRect = @import("webapi/DOMRect.zig");
+const Allocator = std.mem.Allocator;
+
+pub const Document = opaque {};
+const Rect = extern struct { x: f64 = 0, y: f64 = 0, width: f64 = 0, height: f64 = 0 };
+const Projection = struct {
+    key: usize,
+    parent: ?usize,
+    tag: ?[]const u8 = null,
+    text: ?[]const u8 = null,
+    namespace: ?[]const u8 = null,
+    attrs: []const [2][]const u8 = &.{},
+    scroll_x: f32 = 0,
+    scroll_y: f32 = 0,
+    sheet: ?[]const u8 = null,
+    shadow_host: ?usize = null,
+    shadow_closed: bool = false,
+    focused: bool = false,
+    hovered: bool = false,
+    active: bool = false,
+    focus_visible: bool = false,
+    selection_focus: ?usize = null,
+    selection_node: ?usize = null,
+};
+
+pub fn viewport(frame: *Frame) @import("Viewport.zig") {
+    const result = frame.page.getViewport();
+    if (frame.iframe) |iframe| {
+        if (frame._embedding_viewport) |embedded| return embedded;
+        const element = iframe.asElement();
+        const owner = element.ownerFrame(frame) orelse return result;
+        _ = document(owner) catch return result;
+        return frame._embedding_viewport orelse result;
+    }
+    return result;
+}
+fn inputTarget(frame: *Frame, target: ?*Element) ?*Element {
+    var element = target orelse return null;
+    var owner = element.ownerFrame(frame) orelse return null;
+    while (owner != frame) {
+        const iframe = owner.iframe orelse return null;
+        element = iframe.asElement();
+        owner = element.ownerFrame(owner) orelse return null;
+    }
+    return element;
+}
+
+pub fn document(frame: *Frame) !*Document {
+    const lease = try frame._session.getArena(.large, "native-layout");
+    defer lease.release();
+    const arena = lease.allocator();
+    var projected: std.ArrayList(Projection) = .empty;
+    var stack: std.ArrayList(*Node) = .empty;
+    try stack.append(arena, frame.document.asNode());
+    const hovered = inputTarget(frame, frame.page.input_hover_target);
+    const active = inputTarget(frame, frame.page.input_pointer.down_target);
+    while (stack.pop()) |node| {
+        var item: Projection = .{ .key = @intFromPtr(node), .parent = if (node.parentNode()) |parent| @intFromPtr(parent) else null };
+        if (node.is(Element)) |el| {
+            item.tag = el.getTagNameLower();
+            item.namespace = el.getNamespaceURI();
+            item.focused = frame.document._active_element == el;
+            item.focus_visible = el.hasVisibleFocus(frame);
+            item.hovered = hovered == el;
+            item.active = active == el;
+            var attrs: std.ArrayList([2][]const u8) = .empty;
+            const inline_style = el.inlineStyle(frame);
+            const input = el.is(Element.Html.Input);
+            for (el.attributeEntries()) |*attr| {
+                if (inline_style != null and std.mem.eql(u8, attr.name(), "style")) continue;
+                if (input != null and std.mem.eql(u8, attr.name(), "value")) continue;
+                try attrs.append(arena, .{ attr.name(), attr.value() });
+            }
+            if (inline_style) |style| {
+                var writer: std.Io.Writer.Allocating = .init(arena);
+                try style.asCSSStyleDeclaration().format(&writer.writer);
+                try attrs.append(arena, .{ "style", writer.written() });
+            }
+            if (input) |control| {
+                try attrs.append(arena, .{ "value", control.getValue() });
+                if (control.tracksSelection()) item.selection_focus = controlSelectionFocus(control);
+            }
+            if (el.is(Element.Html.TextArea)) |control| {
+                item.text = control.getValue();
+                item.selection_focus = controlSelectionFocus(control);
+            }
+            const sheet = if (el.is(Element.Html.Link)) |link| link._sheet else if (el.is(Element.Html.Style)) |style| style._sheet else null;
+            if (sheet) |css| if (!css._disabled) {
+                if (css._css_rules) |rules| {
+                    var writer: std.Io.Writer.Allocating = .init(arena);
