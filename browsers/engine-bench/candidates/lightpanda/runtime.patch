+fn buffer_len(width:u32,height:u32)->Option<usize>{(width as usize).checked_mul(height as usize)?.checked_mul(4).filter(|n|*n<=268435456)}
+fn surface_len(width:u32,height:u32)->Option<usize>{if width>16384||height>16384{return None;}buffer_len(width,height)}
+unsafe fn bytes<'a>(data:*const u8,len:usize)->Option<&'a[u8]>{if len==0{Some(&[])}else if data.is_null(){None}else{Some(std::slice::from_raw_parts(data,len))}}
+#[no_mangle]
+pub unsafe extern "C" fn lp_canvas_new(width:u32,height:u32,fonts:*const u8,len:usize)->*mut Canvas {
+    catch_unwind(AssertUnwindSafe(||{let length=surface_len(width,height)?;let fonts:Vec<PathBuf>=serde_json::from_slice(bytes(fonts,len)?).ok()?;
+        Some(Box::into_raw(Box::new(Canvas{width,height,pixels:vec![0;length],path:Vec::new(),state:State::default(),saved:Vec::new(),text:CanvasTextEngine::from_font_files(&fonts).ok()?})))
+    })).ok().flatten().unwrap_or(std::ptr::null_mut())
+}
+#[no_mangle]
+pub unsafe extern "C" fn lp_canvas_free(value:*mut Canvas){if !value.is_null(){drop(Box::from_raw(value));}}
+#[no_mangle]
+pub unsafe extern "C" fn lp_canvas_command(value:*mut Canvas,data:*const u8,len:usize,context:*mut c_void,write:Write)->bool {
+    catch_unwind(AssertUnwindSafe(||{let Some(value)=value.as_mut()else{return false};let Some(data)=bytes(data,len)else{return false};let Ok(request)=serde_json::from_slice(data)else{return false};let Ok(result)=value.command(&request)else{return false};let Ok(data)=serde_json::to_vec(&result)else{return false};write(context,data.as_ptr(),data.len())})).unwrap_or(false)
+}
+#[no_mangle]
+pub unsafe extern "C" fn lp_canvas_pixels(value:*const Canvas,out:*mut u8,len:usize)->bool {
+    let Some(value)=value.as_ref()else{return false};if len!=value.pixels.len(){return false;}if len==0{return true;}if out.is_null(){return false;}std::slice::from_raw_parts_mut(out,len).copy_from_slice(&value.pixels);true
+}
+#[no_mangle]
+pub unsafe extern "C" fn lp_canvas_put(value:*mut Canvas,data:*const u8,width:u32,height:u32,x:i32,y:i32)->bool {
+    let Some(value)=value.as_mut()else{return false};let Some(len)=buffer_len(width,height)else{return false};let Some(data)=bytes(data,len)else{return false};
+    let sx0=(-(x as i64)).max(0).min(width as i64)as usize;let sy0=(-(y as i64)).max(0).min(height as i64)as usize;
+    let sx1=(value.width as i64-x as i64).max(0).min(width as i64)as usize;let sy1=(value.height as i64-y as i64).max(0).min(height as i64)as usize;
+    if sx1<=sx0||sy1<=sy0{return true;}let row_bytes=(sx1-sx0)*4;
+    for sy in sy0..sy1{let src=(sy*width as usize+sx0)*4;let dst=((y as i64+sy as i64)as usize*value.width as usize+(x as i64+sx0 as i64)as usize)*4;value.pixels[dst..dst+row_bytes].copy_from_slice(&data[src..src+row_bytes]);}true
+}
+#[no_mangle]
+pub unsafe extern "C" fn lp_canvas_png(value:*const Canvas,context:*mut c_void,write:Write)->bool {
+    let Some(value)=value.as_ref()else{return false};lp_rgba_png(value.pixels.as_ptr(),value.width,value.height,context,write)
+}
+#[no_mangle]
+pub unsafe extern "C" fn lp_canvas_draw_pixels(value:*mut Canvas,data:*const u8,width:u32,height:u32,coords:*const f64)->bool {
+    catch_unwind(AssertUnwindSafe(||{let Some(value)=value.as_mut()else{return false};let Some(len)=buffer_len(width,height)else{return false};let Some(data)=bytes(data,len)else{return false};if coords.is_null(){return false;}let coords=std::slice::from_raw_parts(coords,8);value.draw_pixels(data,width,height,std::array::from_fn(|i|coords[i]as f32)).is_ok()})).unwrap_or(false)
+}
+#[no_mangle]
+pub unsafe extern "C" fn lp_canvas_draw_encoded(value:*mut Canvas,data:*const u8,len:usize,coords:*const f64)->bool {
+    catch_unwind(AssertUnwindSafe(||{let Some(value)=value.as_mut()else{return false};let Some(data)=bytes(data,len)else{return false};if coords.is_null(){return false;}let Ok(image)=::image::load_from_memory(data)else{return false};let image=image.to_rgba8();let coords=std::slice::from_raw_parts(coords,8);value.draw_pixels(image.as_raw(),image.width(),image.height(),std::array::from_fn(|i|coords[i]as f32)).is_ok()})).unwrap_or(false)
+}
+#[no_mangle]
+pub unsafe extern "C" fn lp_canvas_resize(value:*mut Canvas,width:u32,height:u32)->bool {
+    let Some(value)=value.as_mut()else{return false};let Some(length)=surface_len(width,height)else{return false};
+    value.width=width;value.height=height;value.pixels.resize(length,0);value.pixels.fill(0);value.path.clear();value.saved.clear();value.state=State::default();true
+}
+#[no_mangle]
+pub unsafe extern "C" fn lp_rgba_png(data:*const u8,width:u32,height:u32,context:*mut c_void,write:Write)->bool {
+    let Some(length)=buffer_len(width,height)else{return false};if width==0||height==0{return false;}let Some(data)=bytes(data,length)else{return false};let mut output=Vec::new();
+    {let mut encoder=png::Encoder::new(&mut output,width,height);encoder.set_color(png::ColorType::Rgba);encoder.set_depth(png::BitDepth::Eight);let Ok(mut encoder)=encoder.write_header()else{return false};if encoder.write_image_data(data).is_err(){return false;}}
+    write(context,output.as_ptr(),output.len())
+}
diff --git a/src/rust/render/native_graphics.rs b/src/rust/render/native_graphics.rs
new file mode 100644
index 0000000..defc83c
--- /dev/null
+++ b/src/rust/render/native_graphics.rs
@@ -0,0 +1,92 @@
+//! C boundary for the real macOS CGL driver and CPU rasterizer.
+use std::{ffi::c_void, panic::{catch_unwind,AssertUnwindSafe}};
+use obscura_render::graphics::GlContext;
+type Write=unsafe extern "C" fn(*mut c_void,*const u8,usize)->bool;
+static GL_BACKEND:std::sync::OnceLock<String>=std::sync::OnceLock::new();
+// A transferred placeholder may be painted on the Frame thread while its
+// Worker issues GPU commands. Never create aliased &mut GlContext at the ABI.
+pub struct Backend { gl: std::sync::Mutex<GlContext> }
+unsafe fn with_gl(value:*mut Backend,operation:impl FnOnce(&mut GlContext)->bool)->bool {
+    catch_unwind(AssertUnwindSafe(|| {
+        let Some(backend)=value.as_ref() else{return false};
+        let Ok(mut gl)=backend.gl.lock() else{return false};
+        operation(&mut gl)
+    })).unwrap_or(false)
+}
+unsafe fn input<'a>(data:*const u8,len:usize)->Option<&'a [u8]> {
+    if len==0 {Some(&[])} else if data.is_null(){None} else {Some(std::slice::from_raw_parts(data,len))}
+}
+unsafe fn output<'a>(data:*mut u8,len:usize)->Option<&'a mut [u8]> {
+    if len==0 {Some(&mut [])} else if data.is_null(){None} else {Some(std::slice::from_raw_parts_mut(data,len))}
+}
+#[no_mangle]
+pub extern "C" fn lp_gl_new(width:u32,height:u32)->*mut Backend {
+    catch_unwind(AssertUnwindSafe(|| {
+        let gl=GlContext::new_with_backend(width,height,GL_BACKEND.get().map(String::as_str).unwrap_or("cgl-default")).ok()?;
+        Some(Box::into_raw(Box::new(Backend{gl:std::sync::Mutex::new(gl)})))
+    })).ok().flatten().unwrap_or(std::ptr::null_mut())
+}
+#[no_mangle]
+pub unsafe extern "C" fn lp_gl_free(value:*mut Backend){if !value.is_null(){drop(Box::from_raw(value));}}
+#[no_mangle]
+pub unsafe extern "C" fn lp_gl_command(value:*mut Backend,json:*const u8,len:usize,context:*mut c_void,write:Write)->bool{
+    with_gl(value,|gl|{
+        let Some(json)=input(json,len) else{return false};
+        let Ok(request)=serde_json::from_slice(json) else{return false};
+        let Ok(result)=gl.command(&request) else{return false};
+        let Ok(bytes)=serde_json::to_vec(&result) else{return false};
+        write(context,bytes.as_ptr(),bytes.len())
+    })
+}
+#[no_mangle]
+pub unsafe extern "C" fn lp_gl_readback(value:*mut Backend,pixels:*mut u8,len:usize)->bool{
+    with_gl(value,|gl|output(pixels,len).is_some_and(|pixels|gl.readback(pixels).is_ok()))
+}
+
+#[no_mangle]
+pub unsafe extern "C" fn lp_gl_resize(value:*mut Backend,width:u32,height:u32)->bool {
+    with_gl(value,|gl|gl.resize(width,height).is_ok())
+}
+
+#[derive(serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Configuration {files:Vec<std::path::PathBuf>,families:Vec<String>,locale:String,fonts_sha256:String,gl_backend:String}
+#[no_mangle]
+pub unsafe extern "C" fn lp_graphics_configure(json:*const u8,len:usize)->bool {
+    catch_unwind(AssertUnwindSafe(||{
+        let Ok(config)=serde_json::from_slice::<Configuration>(std::slice::from_raw_parts(json,len)) else{return false};
+        if obscura_render::graphics::configure_fonts(&config.files,&config.families,&config.locale).is_err(){return false;}
+        let Ok(hashes)=obscura_render::graphics::font_assets_sha256(&config.files) else{return false};
+        let Ok(canonical)=serde_json::to_vec(&hashes) else{return false};
+        use sha2::Digest;
+        if format!("{:x}",sha2::Sha256::digest(&canonical))!=config.fonts_sha256{return false;}
+        if GlContext::new_with_backend(1,1,&config.gl_backend).is_err(){return false;}
+        if GL_BACKEND.get().is_some_and(|backend|backend!=&config.gl_backend){return false;}
+        let _=GL_BACKEND.set(config.gl_backend);
+        true
+    })).unwrap_or(false)
+}
+
+#[repr(C)]
+pub struct TextureParameters {target:u32,level:i32,internal:i32,width:i32,height:i32,border:i32,format:u32,kind:u32}
+#[no_mangle]
+pub unsafe extern "C" fn lp_gl_tex_image(value:*mut Backend,parameters:*const TextureParameters,data:*const u8,len:usize)->bool{
+    with_gl(value,|gl|{
+        let Some(p)=parameters.as_ref()else{return false};
+        let pixels=if data.is_null(){if len!=0{return false};None}else{let Some(bytes)=input(data,len)else{return false};Some(bytes)};
+        gl.upload_texture_2d(p.target,p.level,p.internal,p.width,p.height,p.border,p.format,p.kind,pixels).is_ok()
+    })
+}
+#[no_mangle]
+pub unsafe extern "C" fn lp_gl_tex_sub_image(value:*mut Backend,target:u32,level:i32,x:i32,y:i32,width:i32,height:i32,format:u32,kind:u32,data:*const u8,len:usize)->bool{
+    with_gl(value,|gl|input(data,len).is_some_and(|pixels|gl.upload_texture_sub_2d(target,level,x,y,width,height,format,kind,pixels).is_ok()))
+}
+#[no_mangle]
+pub unsafe extern "C" fn lp_gl_read_pixels(value:*mut Backend,x:i32,y:i32,width:i32,height:i32,format:u32,kind:u32,data:*mut u8,len:usize)->bool{
+    with_gl(value,|gl|output(data,len).is_some_and(|pixels|gl.read_pixels(x,y,width,height,format,kind,pixels).is_ok()))
+}
+
+#[no_mangle]
+pub unsafe extern "C" fn lp_gl_clear_bitmap(value:*mut Backend)->bool{
+    with_gl(value,|gl|gl.clear_bitmap().is_ok())
+}
diff --git a/src/rust/render/native_layout.rs b/src/rust/render/native_layout.rs
new file mode 100644
index 0000000..d52d491
--- /dev/null
+++ b/src/rust/render/native_layout.rs
@@ -0,0 +1,455 @@
+//! Read-only LP DOM projection. This module has no JS runtime or HTTP client.
+use std::{collections::HashMap, ffi::c_void, panic::{catch_unwind, AssertUnwindSafe}};
+use html5ever::{LocalName, Namespace, QualName};
+use obscura_dom::{Attribute, DomTree, NodeData, NodeId};
+use obscura_render::{PreparedRender, RenderResourceCache, ResolvedScrollState};
+use serde::Deserialize;
+
+#[derive(Deserialize)]
+struct Node {
+    key: usize, parent: Option<usize>, tag: Option<String>, text: Option<String>,
+    namespace: Option<String>, attrs: Vec<(String, String)>, scroll_x: f32, scroll_y: f32,
+    sheet: Option<String>, shadow_host: Option<usize>, shadow_closed: bool,
+    focused: bool, focus_visible: bool, hovered: bool, active: bool,
+    selection_focus: Option<usize>,
+}
+type Load = unsafe extern "C" fn(*mut c_void, *const u8, usize, *mut usize) -> *const u8;
+type Surface = unsafe extern "C" fn(*mut c_void,usize,*mut u32,*mut u32,*mut usize)->*const u8;
+pub struct Document {
+    tree: DomTree, prepared: PreparedRender, resources: RenderResourceCache,
+    ids: HashMap<usize, NodeId>, keys: HashMap<NodeId, usize>, scroll: ResolvedScrollState,
+    context: *mut c_void, surface: Surface,
+    painted: bool,
+}
+#[repr(C)]
+pub struct Rect { x: f64, y: f64, width: f64, height: f64 }
+#[repr(C)]
+#[derive(Default)]
+pub struct Metrics {
+    x:f64,y:f64,width:f64,height:f64,client_width:f64,client_height:f64,
+    scroll_width:f64,scroll_height:f64,scroll_x:f64,scroll_y:f64,max_x:f64,max_y:f64,
+    border_left:f64,border_top:f64,
+}
+
+struct Surfaces<'a> { keys: &'a HashMap<NodeId,usize>, context:*mut c_void, surface:Surface }
+impl obscura_render::CanvasSurfaceSource for Surfaces<'_> {
+    fn surface(&self,id:NodeId)->Option<obscura_render::CanvasSurface<'_>> {
+        let key=*self.keys.get(&id)?;
+        let(mut width,mut height,mut len)=(0,0,0);
+        let bytes=unsafe{(self.surface)(self.context,key,&mut width,&mut height,&mut len)};
+        if bytes.is_null(){return None;}
+        obscura_render::CanvasSurface::from_rgba8(width,height,unsafe{std::slice::from_raw_parts(bytes,len)})
+    }
+}
+
+#[no_mangle]
+pub unsafe extern "C" fn lp_document_new(
+    json: *const u8, len: usize, base: *const u8, base_len: usize,
+    width: f32, height: f32, x: f32, y: f32, context: *mut c_void, load: Load, surface:Surface,
+) -> *mut Document {
+    catch_unwind(AssertUnwindSafe(|| {
+        let nodes: Vec<Node> = serde_json::from_slice(std::slice::from_raw_parts(json, len)).ok()?;
+        let base = std::str::from_utf8(std::slice::from_raw_parts(base, base_len)).ok()?;
+        let tree = DomTree::new();
+        let mut ids = HashMap::new();
+        let mut keys = HashMap::new();
+        let mut requested = HashMap::new();
+        for node in nodes {
+            let is_element=node.tag.is_some();
+            let mut text=node.text;
+            let id = if let Some(host)=node.shadow_host {
+                tree.attach_shadow_root(*ids.get(&host)?,if node.shadow_closed {obscura_dom::ShadowRootMode::Closed}else{obscura_dom::ShadowRootMode::Open}).ok()?
+            } else if node.tag.is_none() && text.is_none() { NodeId::new(0) } else {
+                let data = if let Some(tag) = node.tag {
+                    NodeData::Element {
+                        name: QualName::new(None, Namespace::from(node.namespace.as_deref().unwrap_or("http://www.w3.org/1999/xhtml")), LocalName::from(tag)),
+                        attrs: node.attrs.into_iter().map(|(name,value)| Attribute {
+                            name: QualName::new(None, Namespace::default(), LocalName::from(name)), value,
+                        }).collect(), template_contents: None, mathml_annotation_xml_integration_point: false,
+                    }
+                } else { NodeData::Text { contents: text.take().unwrap_or_default() } };
+                let id = tree.new_node(data);
+                tree.append_child(node.parent.and_then(|key| ids.get(&key).copied()).unwrap_or(NodeId::new(0)), id);
+                id
+            };
+            if is_element { if let Some(text)=text {tree.append_text(id,&text);} }
+            if let Some(sheet)=node.sheet {tree.append_external_stylesheet(id,sheet,true);}
+            requested.insert(id, (node.scroll_x,node.scroll_y));
+            ids.insert(node.key,id); keys.insert(id,node.key);
+            if is_element {
+                if let Some(focus)=node.selection_focus {
+                    tree.update_form_control_state(id, |state| state.selection_focus = Some(focus));
+                }
+            }
+            if node.focused { tree.set_focused(Some(id)); tree.set_focus_visible(node.focus_visible); }
+            if node.hovered { tree.set_hovered(Some(id)); }
+            if node.active { tree.set_active(Some(id)); }
+        }
+        // The callback only returns LP-owned bytes already fetched by LP. A miss
+        // remains missing: the renderer must never fetch a resource itself.
+        let mut resources = RenderResourceCache::with_loader(move |url: &str| {
+            let mut len = 0;
+            let bytes = load(context, url.as_ptr(), url.len(), &mut len);
+            if bytes.is_null() { None } else { Some(std::slice::from_raw_parts(bytes,len).to_vec()) }
+        });
+        let prepared = obscura_render::prepare_dom_with_dynamic_fonts(&tree,(width,height),Some(base),&mut resources,&[])?;
+        let scroll = prepared.resolve_scroll_state(&tree,(x,y),&requested);
+        Some(Box::into_raw(Box::new(Document { tree,prepared,resources,ids,keys,scroll,context,surface,painted:false })))
+    })).ok().flatten().unwrap_or(std::ptr::null_mut())
+}
+#[no_mangle]
+pub unsafe extern "C" fn lp_document_free(document: *mut Document) {
+    if !document.is_null() { drop(Box::from_raw(document)); }
+}
+#[no_mangle]
+pub unsafe extern "C" fn lp_document_clear_paint(document:*mut Document) {
+    if let Some(d)=document.as_mut() {d.painted=false;}
+}
+#[no_mangle]
+pub unsafe extern "C" fn lp_document_rect(document: *const Document,key:usize,out:*mut Rect)->bool {
+    let Some(document)=document.as_ref() else {return false};
+    let Some(id)=document.ids.get(&key) else {return false};
+    let Some(rect)=document.prepared.viewport_rect_with_scroll(*id,&document.scroll) else {return false};
+    *out=Rect{x:rect.x as f64,y:rect.y as f64,width:rect.width as f64,height:rect.height as f64}; true
+}
+
+/// The offset is a native DOM UTF-16 boundary for ordinary text. Controls use
+/// the live UTF-8 selection_focus projected before the exact last paint.
+#[no_mangle]
+pub unsafe extern "C" fn lp_document_caret(
+    document:*const Document,key:usize,offset:usize,control:bool,out:*mut Rect,
+)->bool {
+    let Some(d)=document.as_ref() else {return false};
+    if out.is_null() || !d.painted {return false;}
+    let Some(id)=d.ids.get(&key) else {return false};
+    let rect=if control {d.prepared.native_control_caret_rect(*id)}
+        else {d.prepared.caret_rect(&d.tree,&d.scroll,*id,offset)};
+    let Some(rect)=rect else {return false};
+    *out=Rect{x:rect.x as f64,y:rect.y as f64,width:rect.width as f64,height:rect.height as f64};
+    true
+}
+
+/// Map a child viewport into precisely the content destination used for its
+/// iframe surface. Axis-preserving affine transforms are exact for a Rect;
+/// rotation/skew would lose insertion geometry through nested AABBs, so callers
+/// must explicitly fall back rather than claiming a shaped insertion there.
+#[no_mangle]
+pub unsafe extern "C" fn lp_document_embed_rect(
+    document:*const Document,key:usize,width:u32,height:u32,out:*mut Rect,
+)->bool {
+    let Some(d)=document.as_ref() else {return false};
+    if out.is_null() || !d.painted || width==0 || height==0 {return false;}
+    let Some(id)=d.ids.get(&key) else {return false};
+    let layout=d.prepared.layout();
+    let Some(border)=layout.rects.get(id) else {return false};
+    let Some(style)=layout.styles.get(id) else {return false};
+    let transform=layout.transforms.get(id).copied().unwrap_or_default();
+    if transform.b!=0. || transform.c!=0. || transform.a==0. || transform.d==0. {return false;}
+    let Some(viewport)=d.prepared.viewport_rect_with_scroll(*id,&d.scroll) else {return false};
+    let visual=transform.map_rect(*border);
+    let content=obscura_render::Rect {
+        x:border.x+style.border.left+style.padding.left,
+        y:border.y+style.border.top+style.padding.top,
+        width:(border.width-style.border.left-style.border.right-style.padding.left-style.padding.right).max(0.),
+        height:(border.height-style.border.top-style.border.bottom-style.padding.top-style.padding.bottom).max(0.),
+    };
+    let value=&*out;
+    let local=obscura_render::Rect {
+        x:content.x+(value.x/width as f64*content.width as f64) as f32,
+        y:content.y+(value.y/height as f64*content.height as f64) as f32,
+        width:(value.width/width as f64*content.width as f64) as f32,
+        height:(value.height/height as f64*content.height as f64) as f32,
+    };
+    if content.width<=0. || content.height<=0. {return false;}
+    let mapped=transform.map_rect(local);
+    *out=Rect{x:(mapped.x+viewport.x-visual.x) as f64,y:(mapped.y+viewport.y-visual.y) as f64,
+        width:mapped.width as f64,height:mapped.height as f64};
+    true
+}
+#[no_mangle]
+pub unsafe extern "C" fn lp_document_hit(document:*const Document,x:f32,y:f32)->usize {
+    let Some(document)=document.as_ref() else {return 0};
+    document.prepared.hit_test(&document.tree,&document.scroll,x,y)
+        .and_then(|id|document.keys.get(&id).copied()).unwrap_or(0)
+}
+#[no_mangle]
+pub unsafe extern "C" fn lp_document_height(document:*const Document)->f32 {
+    document.as_ref().map(|d|d.prepared.content_size().1).unwrap_or(0.0)
+}
+#[no_mangle]
+pub unsafe extern "C" fn lp_document_png(document:*mut Document,opts:super::LpRenderOpts,context:*mut c_void,write:unsafe extern "C" fn(*mut c_void,*const u8,usize)->bool)->i32 {
+    catch_unwind(AssertUnwindSafe(|| {
+        let Some(d)=document.as_mut() else {return -1};
+        let height=if opts.height==0 {d.prepared.content_size().1} else {opts.height as f32};
+        let region=if opts.clip_w>0.0 {
+            obscura_render::CaptureRegion::new(opts.clip_x,opts.clip_y,opts.clip_w,opts.clip_h,opts.scale)
+        } else {obscura_render::CaptureRegion::new(0.0,0.0,opts.width as f32,height,opts.scale)};
+        let surfaces=Surfaces{keys:&d.keys,context:d.context,surface:d.surface};
+        let Ok(bytes)=obscura_render::screenshot_prepared_region_with_scroll_and_surface_color_and_canvas_surfaces(&d.tree,&mut d.prepared,&mut d.resources,&d.scroll,region,[255,255,255,255],&surfaces) else {return -1};
+        d.painted=true;
+        if write(context,bytes.as_ptr(),bytes.len()) {0} else {-1}
+    })).unwrap_or(-1)
+}
