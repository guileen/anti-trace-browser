diff --git a/src/browser/webapi/canvas/Path2D.zig b/src/browser/webapi/canvas/Path2D.zig
new file mode 100644
index 0000000..3db5ec7
--- /dev/null
+++ b/src/browser/webapi/canvas/Path2D.zig
@@ -0,0 +1,282 @@
+const std = @import("std");
+const js = @import("../../js/js.zig");
+const context2d = @import("context2d.zig");
+const PathData = @import("../svg/PathData.zig");
+const Path2D = @This();
+pub const _prototype_root = true;
+pub const Point = struct { x: f64 = 0, y: f64 = 0 };
+pub const Command = struct { t: []const u8, x: f64 = 0, y: f64 = 0, x1: f64 = 0, y1: f64 = 0, x2: f64 = 0, y2: f64 = 0 };
+commands: std.ArrayList(Command) = .empty,
+current: ?Point = null,
+start: ?Point = null,
+_allocator: ?std.mem.Allocator = null,
+fn allocator(self: *const Path2D, e: *js.Execution) std.mem.Allocator {
+    return self._allocator orelse e.page_arena;
+}
+pub const Input = union(enum) { path: *Path2D, svg: []const u8 };
+pub fn constructor(input: ?Input, e: *js.Execution) !*Path2D {
+    const path = try e._factory.create(Path2D{});
+    if (input) |value| switch (value) {
+        .path => |other| {
+            try path.commands.appendSlice(e.page_arena, other.commands.items);
+            path.current = other.current;
+            path.start = other.start;
+        },
+        .svg => |svg| try path.parse(svg, e),
+    };
+    return path;
+}
+fn parse(self: *Path2D, svg: []const u8, e: *js.Execution) !void {
+    const parsed = try PathData.parseWithEvents(svg, e.local_arena);
+    // Reuse LP's SVG curve parser while preserving explicit move/close events.
+    var boundary: usize = 0;
+    for (0..parsed.segments.items.len + 1) |index| {
+        while (boundary < parsed.boundaries.items.len and parsed.boundaries.items[boundary].segment_index == index) {
+            const event = parsed.boundaries.items[boundary];
+            boundary += 1;
+            switch (event.kind) {
+                .move => try self.moveTo(event.point.x, event.point.y, e),
+                .close => try self.closePath(e),
+            }
+        }
+        if (index == parsed.segments.items.len) break;
+        switch (parsed.segments.items[index]) {
+            .line => |s| try self.lineTo(s.end.x, s.end.y, e),
+            .quadratic => |s| try self.quadraticCurveTo(s.control.x, s.control.y, s.end.x, s.end.y, e),
+            .cubic => |s| try self.bezierCurveTo(s.control1.x, s.control1.y, s.control2.x, s.control2.y, s.end.x, s.end.y, e),
+            .arc => |s| try self.ellipse(s.center.x, s.center.y, s.rx, s.ry, s.rotation, s.theta, s.theta + s.delta, s.delta < 0, e),
+        }
+    }
+}
+fn finite(values: []const f64) bool {
+    for (values) |v| if (!std.math.isFinite(v)) return false;
+    return true;
+}
+pub fn moveTo(self: *Path2D, x: f64, y: f64, e: *js.Execution) !void {
+    if (!finite(&.{ x, y })) return;
+    try self.commands.append(self.allocator(e), .{ .t = "M", .x = x, .y = y });
+    self.current = .{ .x = x, .y = y };
+    self.start = self.current;
+}
+pub fn lineTo(self: *Path2D, x: f64, y: f64, e: *js.Execution) !void {
+    if (!finite(&.{ x, y })) return;
+    if (self.current == null) return self.moveTo(x, y, e);
+    try self.commands.append(self.allocator(e), .{ .t = "L", .x = x, .y = y });
+    self.current = .{ .x = x, .y = y };
+}
+pub fn closePath(self: *Path2D, e: *js.Execution) !void {
+    if (self.start == null) return;
+    try self.commands.append(self.allocator(e), .{ .t = "Z" });
+    self.current = self.start;
+}
+pub fn quadraticCurveTo(self: *Path2D, x1: f64, y1: f64, x: f64, y: f64, e: *js.Execution) !void {
+    if (!finite(&.{ x1, y1, x, y })) return;
+    if (self.current == null) try self.moveTo(x1, y1, e);
+    try self.commands.append(self.allocator(e), .{ .t = "Q", .x1 = x1, .y1 = y1, .x = x, .y = y });
+    self.current = .{ .x = x, .y = y };
+}
+pub fn bezierCurveTo(self: *Path2D, x1: f64, y1: f64, x2: f64, y2: f64, x: f64, y: f64, e: *js.Execution) !void {
+    if (!finite(&.{ x1, y1, x2, y2, x, y })) return;
+    if (self.current == null) try self.moveTo(x1, y1, e);
+    try self.commands.append(self.allocator(e), .{ .t = "C", .x1 = x1, .y1 = y1, .x2 = x2, .y2 = y2, .x = x, .y = y });
+    self.current = .{ .x = x, .y = y };
+}
+pub fn rect(self: *Path2D, x: f64, y: f64, w: f64, h: f64, e: *js.Execution) !void {
+    if (!finite(&.{ x, y, w, h })) return;
+    try self.moveTo(x, y, e);
+    try self.lineTo(x + w, y, e);
+    try self.lineTo(x + w, y + h, e);
+    try self.lineTo(x, y + h, e);
+    try self.closePath(e);
+}
+pub fn arc(self: *Path2D, x: f64, y: f64, r: f64, start_: f64, end: f64, ccw: ?bool, e: *js.Execution) !void {
+    try self.ellipse(x, y, r, r, 0, start_, end, ccw, e);
+}
+fn ellipsePoint(cx: f64, cy: f64, rx: f64, ry: f64, rotation: f64, t: f64) Point {
+    return .{ .x = cx + rx * @cos(t) * @cos(rotation) - ry * @sin(t) * @sin(rotation), .y = cy + rx * @cos(t) * @sin(rotation) + ry * @sin(t) * @cos(rotation) };
+}
+fn ellipseTangent(rx: f64, ry: f64, rotation: f64, t: f64) Point {
+    return .{ .x = -rx * @sin(t) * @cos(rotation) - ry * @cos(t) * @sin(rotation), .y = -rx * @sin(t) * @sin(rotation) + ry * @cos(t) * @cos(rotation) };
+}
+pub fn ellipse(self: *Path2D, cx: f64, cy: f64, rx: f64, ry: f64, rotation: f64, start_: f64, end: f64, ccw: ?bool, e: *js.Execution) !void {
+    if (rx < 0 or ry < 0) return error.IndexSizeError;
+    if (!finite(&.{ cx, cy, rx, ry, rotation, start_, end })) return;
+    const tau = 2 * std.math.pi;
+    var delta = end - start_;
+    if (ccw orelse false) {
+        if (-delta >= tau) delta = -tau else {
+            delta = @mod(delta, tau);
+            if (delta > 0) delta -= tau;
+        }
+    } else {
+        if (delta >= tau) delta = tau else delta = @mod(delta, tau);
+    }
+    const first = ellipsePoint(cx, cy, rx, ry, rotation, start_);
+    if (self.current == null) try self.moveTo(first.x, first.y, e) else try self.lineTo(first.x, first.y, e);
+    if (delta == 0) return;
+    const count: usize = @intFromFloat(@ceil(@abs(delta) / (std.math.pi / @as(f64, 2))));
+    const step = delta / @as(f64, @floatFromInt(count));
+    for (0..count) |i| {
+        const a = start_ + @as(f64, @floatFromInt(i)) * step;
+        const b = a + step;
+        const p0 = ellipsePoint(cx, cy, rx, ry, rotation, a);
+        const p1 = ellipsePoint(cx, cy, rx, ry, rotation, b);
+        const v0 = ellipseTangent(rx, ry, rotation, a);
+        const v1 = ellipseTangent(rx, ry, rotation, b);
+        const k = 4.0 / 3.0 * @tan(step / 4);
+        try self.bezierCurveTo(p0.x + k * v0.x, p0.y + k * v0.y, p1.x - k * v1.x, p1.y - k * v1.y, p1.x, p1.y, e);
+    }
+}
+pub fn arcTo(self: *Path2D, x1: f64, y1: f64, x2: f64, y2: f64, r: f64, e: *js.Execution) !void {
+    if (r < 0) return error.IndexSizeError;
+    if (!finite(&.{ x1, y1, x2, y2, r })) return;
+    const p = self.current orelse return self.moveTo(x1, y1, e);
+    var ux = p.x - x1;
+    var uy = p.y - y1;
+    var vx = x2 - x1;
+    var vy = y2 - y1;
+    const ul = @sqrt(ux * ux + uy * uy);
+    const vl = @sqrt(vx * vx + vy * vy);
+    const cross = ux * vy - uy * vx;
+    if (ul == 0 or vl == 0 or cross == 0 or r == 0) return self.lineTo(x1, y1, e);
+    ux /= ul;
+    uy /= ul;
+    vx /= vl;
+    vy /= vl;
+    const angle = std.math.acos(std.math.clamp(ux * vx + uy * vy, -1, 1));
+    const dist = r / @tan(angle / 2);
+    const t0 = Point{ .x = x1 + ux * dist, .y = y1 + uy * dist };
+    const t1 = Point{ .x = x1 + vx * dist, .y = y1 + vy * dist };
+    const sign: f64 = if (cross < 0) -1 else 1;
+    const cx = t0.x - sign * uy * r;
+    const cy = t0.y + sign * ux * r;
+    try self.lineTo(t0.x, t0.y, e);
+    try self.arc(cx, cy, r, std.math.atan2(t0.y - cy, t0.x - cx), std.math.atan2(t1.y - cy, t1.x - cx), cross > 0, e);
+}
+pub const Radius = union(enum) { number: f64, point: Point };
+pub const Radii = union(enum) { number: f64, list: []const Radius, point: Point };
+fn radius(value: Radius) !Point {
+    const p = switch (value) {
+        .number => |n| Point{ .x = n, .y = n },
+        .point => |point| point,
+    };
+    if (p.x < 0 or p.y < 0) return error.RangeError;
+    return p;
+}
+pub fn normalizeRadii(input: ?Radii) ![4]Point {
+    var points: [4]Point = undefined;
+    var n: usize = 1;
+    points[0] = .{ .x = 0, .y = 0 };
+    if (input) |value| switch (value) {
+        .number => |v| points[0] = try radius(.{ .number = v }),
+        .point => |p| points[0] = try radius(.{ .point = p }),
+        .list => |values| {
+            n = values.len;
+            if (n == 0 or n > 4) return error.RangeError;
+            for (values, 0..) |v, i| points[i] = try radius(v);
+        },
+    };
+    return switch (n) {
+        1 => .{ points[0], points[0], points[0], points[0] },
+        2 => .{ points[0], points[1], points[0], points[1] },
+        3 => .{ points[0], points[1], points[2], points[1] },
+        else => points,
+    };
+}
+pub fn roundRect(self: *Path2D, x_: f64, y_: f64, w_: f64, h_: f64, input: ?Radii, e: *js.Execution) !void {
+    var r = try normalizeRadii(input);
+    if (!finite(&.{ x_, y_, w_, h_ })) return;
+    for (r) |p| if (!finite(&.{ p.x, p.y })) return;
+    var x = x_;
+    var y = y_;
+    var w = w_;
+    var h = h_;
+    const reverse = w * h < 0;
+    if (w < 0) {
+        x += w;
+        w = -w;
+        std.mem.swap(Point, &r[0], &r[1]);
+        std.mem.swap(Point, &r[3], &r[2]);
+    }
+    if (h < 0) {
+        y += h;
+        h = -h;
+        std.mem.swap(Point, &r[0], &r[3]);
+        std.mem.swap(Point, &r[1], &r[2]);
+    }
+    var factor: f64 = 1;
+    const sums = [4]f64{ r[0].x + r[1].x, r[3].x + r[2].x, r[0].y + r[3].y, r[1].y + r[2].y };
+    for (sums, 0..) |sum, i| if (sum > 0) {
+        factor = @min(factor, (if (i < 2) w else h) / sum);
+    };
+    for (&r) |*p| {
+        p.x *= factor;
+        p.y *= factor;
+    }
+    const begin = self.commands.items.len;
+    try self.moveTo(x + r[0].x, y, e);
+    try self.lineTo(x + w - r[1].x, y, e);
+    try self.ellipse(x + w - r[1].x, y + r[1].y, r[1].x, r[1].y, 0, -std.math.pi / @as(f64, 2), 0, false, e);
+    try self.lineTo(x + w, y + h - r[2].y, e);
+    try self.ellipse(x + w - r[2].x, y + h - r[2].y, r[2].x, r[2].y, 0, 0, std.math.pi / @as(f64, 2), false, e);
+    try self.lineTo(x + r[3].x, y + h, e);
+    try self.ellipse(x + r[3].x, y + h - r[3].y, r[3].x, r[3].y, 0, std.math.pi / @as(f64, 2), std.math.pi, false, e);
+    try self.lineTo(x, y + r[0].y, e);
+    try self.ellipse(x + r[0].x, y + r[0].y, r[0].x, r[0].y, 0, std.math.pi, 3 * std.math.pi / @as(f64, 2), false, e);
+    try self.closePath(e);
+    if (reverse) {
+        // Reverse this subpath's winding, including cubic control directions.
+        const old = try e.local_arena.dupe(Command, self.commands.items[begin..]);
+        self.commands.shrinkRetainingCapacity(begin);
+        const endpoints = try e.local_arena.alloc(Point, old.len);
+        var current_: Point = .{ .x = old[0].x, .y = old[0].y };
+        for (old, 0..) |cmd, i| {
+            endpoints[i] = current_;
+            if (!std.mem.eql(u8, cmd.t, "Z")) current_ = .{ .x = cmd.x, .y = cmd.y };
+        }
+        try self.moveTo(current_.x, current_.y, e);
+        var i = old.len;
+        while (i > 1) {
+            i -= 1;
+            const cmd = old[i];
+            if (std.mem.eql(u8, cmd.t, "Z")) continue;
+            const p = endpoints[i];
+            if (std.mem.eql(u8, cmd.t, "C")) try self.bezierCurveTo(cmd.x2, cmd.y2, cmd.x1, cmd.y1, p.x, p.y, e) else try self.lineTo(p.x, p.y, e);
+        }
+        try self.closePath(e);
+    }
+}
+pub fn addPath(self: *Path2D, other: *Path2D, init: ?@import("../DOMMatrixReadOnly.zig").DOMMatrixInit, e: *js.Execution) !void {
+    const m = try context2d.matrix(init orelse .{});
+    for (m) |v| if (!std.math.isFinite(v)) return;
+    const count = other.commands.items.len;
+    const source = if (self == other) try e.local_arena.dupe(Command, other.commands.items[0..count]) else other.commands.items[0..count];
+    for (source) |cmd| {
+        const p = apply(m, .{ .x = cmd.x, .y = cmd.y });
+        const p1 = apply(m, .{ .x = cmd.x1, .y = cmd.y1 });
+        const p2 = apply(m, .{ .x = cmd.x2, .y = cmd.y2 });
+        if (std.mem.eql(u8, cmd.t, "M")) try self.moveTo(p.x, p.y, e) else if (std.mem.eql(u8, cmd.t, "L")) try self.lineTo(p.x, p.y, e) else if (std.mem.eql(u8, cmd.t, "Q")) try self.quadraticCurveTo(p1.x, p1.y, p.x, p.y, e) else if (std.mem.eql(u8, cmd.t, "C")) try self.bezierCurveTo(p1.x, p1.y, p2.x, p2.y, p.x, p.y, e) else try self.closePath(e);
+    }
+}
+fn apply(m: context2d.Matrix, p: Point) Point {
+    return .{ .x = m[0] * p.x + m[2] * p.y + m[4], .y = m[1] * p.x + m[3] * p.y + m[5] };
+}
+pub const JsApi = struct {
+    pub const bridge = js.Bridge(Path2D);
+    pub const Meta = struct {
+        pub const name = "Path2D";
+        pub var class_id: bridge.ClassId = undefined;
+    };
+    pub const constructor = bridge.constructor(Path2D.constructor, .{});
+    pub const moveTo = bridge.function(Path2D.moveTo, .{});
+    pub const lineTo = bridge.function(Path2D.lineTo, .{});
+    pub const closePath = bridge.function(Path2D.closePath, .{});
+    pub const quadraticCurveTo = bridge.function(Path2D.quadraticCurveTo, .{});
+    pub const bezierCurveTo = bridge.function(Path2D.bezierCurveTo, .{});
+    pub const rect = bridge.function(Path2D.rect, .{});
+    pub const arc = bridge.function(Path2D.arc, .{});
+    pub const ellipse = bridge.function(Path2D.ellipse, .{});
+    pub const arcTo = bridge.function(Path2D.arcTo, .{});
+    pub const roundRect = bridge.function(Path2D.roundRect, .{});
+    pub const addPath = bridge.function(Path2D.addPath, .{});
+};
diff --git a/src/browser/webapi/storage/Persistence.zig b/src/browser/webapi/storage/Persistence.zig
new file mode 100644
index 0000000..bb0732a
--- /dev/null
+++ b/src/browser/webapi/storage/Persistence.zig
@@ -0,0 +1,125 @@
+// Profile storage uses SQLite's crash-recovery journal, never a fresh fallback.
+const std = @import("std");
+const lp = @import("lightpanda");
+const Sqlite = @import("../../../storage/sqlite/Sqlite.zig");
+
+pub const Opened = struct { conn: Sqlite.Conn, existing: bool };
+pub const Kind = enum { local, idb, cookies };
+
+pub fn open(path: [:0]const u8) !Opened {
+    return openChecked(path) catch |err| switch (err) {
+        error.Corrupt, error.NotADB, error.Format, error.CorruptVTab, error.CorruptSequence, error.CorruptIndex => error.incompatible_profile,
+        else => err,
+    };
+}
+
+fn openChecked(path: [:0]const u8) !Opened {
+    const existing = if (std.mem.eql(u8, path, ":memory:")) false else blk: {
+        const stat = std.Io.Dir.cwd().statFile(lp.io, path, .{}) catch |err| switch (err) {
+            error.FileNotFound => break :blk false,
+            else => return err,
+        };
+        if (stat.kind != .file or stat.size == 0) return error.incompatible_profile;
+        break :blk true;
+    };
+    const conn = try Sqlite.Conn.open(path);
+    errdefer conn.close();
+    try conn.busyTimeout(1000);
+    if (existing) try check(conn);
+    // FULL syncs every WAL commit before the mutation/transaction is acknowledged.
+    // fullfsync requests the stronger flush on platforms (notably macOS) that support it.
+    try conn.exec("pragma journal_mode=wal", .{});
+    try conn.exec("pragma synchronous=full", .{});
+    try conn.exec("pragma fullfsync=on", .{});
+    try conn.exec("pragma checkpoint_fullfsync=on", .{});
+    try conn.exec("pragma foreign_keys=on", .{});
+    return .{ .conn = conn, .existing = existing };
+}
+
+pub fn check(conn: Sqlite.Conn) !void {
+    var rows = try conn.rows("pragma integrity_check", .{});
+    defer rows.deinit();
+    var ok = false;
+    while (try rows.next()) |row| {
+        if (!std.mem.eql(u8, row.get([]const u8, 0), "ok")) return error.incompatible_profile;
+        ok = true;
+    }
+    if (!ok) return error.incompatible_profile;
+    var foreign_keys = try conn.rows("pragma foreign_key_check", .{});
+    defer foreign_keys.deinit();
+    if (try foreign_keys.next() != null) return error.incompatible_profile;
+}
+
+pub fn validateSchema(conn: Sqlite.Conn, kind: Kind) !void {
+    // Prepare against every persisted column before accepting the profile. Missing or
+    // incompatible tables must not be repaired into an apparently empty origin.
+    const query: []const u8 = switch (kind) {
+        .local => "select key,value from entries limit 0",
+        .idb => "select d.id,d.name,d.version,s.id,s.database_id,s.name,s.key_path,s.key_path_component_length,s.auto_increment,s.key_generator,r.object_store_id,r.key,r.value,i.id,i.object_store_id,i.name,i.key_path,i.key_path_component_length,i.is_unique,i.multi_entry,x.index_id,x.key,x.primary_key,x.is_unique from idb_databases d,idb_object_stores s,idb_records r,idb_indexes i,idb_index_records x limit 0",
+        .cookies => "select name,value,domain,path,expires,secure,http_only,same_site,same_site_default,creation_time from cookies limit 0",
+    };
+    var rows = conn.rows(query, .{}) catch |err| switch (err) {
+        error.Error => return error.incompatible_profile,
+        else => return err,
+    };
+    defer rows.deinit();
+    _ = try rows.next();
+    if (kind == .local) {
+        const invalid = (try conn.scalar(i64, "select count(*) from entries where typeof(key)!='text' or typeof(value)!='text'", .{})).?;
+        const bytes = (try conn.scalar(i64, "select coalesce(sum(length(cast(value as blob))),0) from entries", .{})).?;
+        if (invalid != 0 or bytes > 5 * 1024 * 1024) return error.incompatible_profile;
+    }
+}
+
+/// Called before publishing ready/getInfo, including when no origin has yet opened.
+pub fn preflight(allocator: std.mem.Allocator, path: []const u8) !void {
+    if (!std.fs.path.isAbsolute(path)) return error.invalid_config;
+    try std.Io.Dir.cwd().createDirPath(lp.io, path);
+    var dir = try std.Io.Dir.cwd().openDir(lp.io, path, .{ .iterate = true });
+    defer dir.close(lp.io);
+    var it = dir.iterate();
+    while (try it.next(lp.io)) |entry| {
+        // An orphaned recovery journal is not an empty/new origin.
+        const suffix: []const u8 = if (std.mem.endsWith(u8, entry.name, ".sqlite-wal")) "-wal" else if (std.mem.endsWith(u8, entry.name, ".sqlite-shm")) "-shm" else if (std.mem.endsWith(u8, entry.name, ".sqlite-journal")) "-journal" else "";
+        if (suffix.len != 0) {
+            const base = entry.name[0 .. entry.name.len - suffix.len];
+            if (std.mem.eql(u8, base, "cookies.sqlite") or std.mem.startsWith(u8, base, "local-") or std.mem.startsWith(u8, base, "idb-")) {
+                _ = dir.statFile(lp.io, base, .{}) catch |err| switch (err) {
+                    error.FileNotFound => return error.incompatible_profile,
+                    else => return err,
+                };
+            }
+            continue;
+        }
+        if (!std.mem.endsWith(u8, entry.name, ".sqlite")) continue;
+        const kind: Kind = if (std.mem.eql(u8, entry.name, "cookies.sqlite")) .cookies else if (std.mem.startsWith(u8, entry.name, "local-")) .local else if (std.mem.startsWith(u8, entry.name, "idb-")) .idb else continue;
+        if (entry.kind != .file) return error.incompatible_profile;
+        const filename = try std.fs.path.joinZ(allocator, &.{ path, entry.name });
+        defer allocator.free(filename);
+        const opened = try open(filename);
+        defer opened.conn.close();
+        try validateSchema(opened.conn, kind);
+    }
+}
+
+test "profile storage rejects corrupt and empty databases instead of recreating them" {
+    const testing = @import("../../../testing.zig");
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    try tmp.dir.writeFile(testing.io, .{ .sub_path = "local-bad.sqlite", .data = "not a database" });
+    const bad_path = try testing.tmpPath(&tmp, "local-bad.sqlite");
+    try testing.expectError(error.incompatible_profile, open(bad_path));
+    try tmp.dir.writeFile(testing.io, .{ .sub_path = "local-empty.sqlite", .data = "" });
+    const empty_path = try testing.tmpPath(&tmp, "local-empty.sqlite");
+    try testing.expectError(error.incompatible_profile, open(empty_path));
+}
+
+test "profile storage rejects orphaned recovery journals" {
+    const testing = @import("../../../testing.zig");
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    try tmp.dir.writeFile(testing.io, .{ .sub_path = "local-lost.sqlite-wal", .data = "orphaned" });
+    const path = try tmp.dir.realPathFileAlloc(testing.io, ".", testing.allocator);
+    defer testing.allocator.free(path);
+    try testing.expectError(error.incompatible_profile, preflight(testing.allocator, path));
+}
diff --git a/src/rust/render/canvas2d.rs b/src/rust/render/canvas2d.rs
new file mode 100644
index 0000000..b31f895
--- /dev/null
+++ b/src/rust/render/canvas2d.rs
@@ -0,0 +1,383 @@
+//! LP-owned surfaces painted by the shared CPU path/text/image components.
+//! Handles own their pixels, drawing state and fonts; no DOM, execution or realm pointers.
+//! Command ABI: `method`, `args`; paints carry RGBA `color`, `alpha`, `composite`,
+//! stroke fields `line_width`, `line_cap`, `line_join`, `miter_limit`, `dash`, `dash_offset`.
+//! Gradients carry `kind`, six `coords`, RGBA `stops`, and creation-time `transform`.
+//! Patterns carry RGBA `pixels` + `width`/`height` or original `encoded` bytes,
+//! `repetition` and their local `transform`. Explicit Path2D `path` commands are local
+//! coordinates (M/L/Q/C/Z), optionally transformed by `path_transform` before the CTM.
+//! `evenodd` applies to fill/clip/hit tests. Hit `args` are device-space [x,y].
+//! Before either image C call, `drawState` sets `alpha`, `composite`, `smooth`;
+//! those calls keep the existing ABI and use the same saved native CTM and clip.
+use std::{ffi::c_void, path::PathBuf, panic::{catch_unwind, AssertUnwindSafe}};
+use obscura_render::graphics::{CanvasTextEngine, TextRequest, canvas::{self, PathCommand, ClipPath, CanvasPaint, CanvasDrawRequest}, image::{self, ImageDrawRequest}};
+use serde_json::{Value, json};
+use tiny_skia::{FillRule, LineCap, LineJoin, Paint, Path, PathSegment, Pixmap, PixmapMut, Pattern, FilterQuality, SpreadMode, Stroke, StrokeDash, Transform};
+
+#[derive(Clone)]
+struct State {
+    transform: [f32; 6], clips: Vec<ClipPath>, alpha: f32, composite: String, smooth: bool,
+}
+impl Default for State {
+    fn default() -> Self { Self { transform: canvas::identity(), clips: Vec::new(), alpha: 1., composite: "source-over".into(), smooth: true } }
+}
+pub struct Canvas {
+    width: u32, height: u32, pixels: Vec<u8>, path: Vec<PathCommand>,
+    state: State, saved: Vec<State>, text: CanvasTextEngine,
+}
+type Write = unsafe extern "C" fn(*mut c_void, *const u8, usize) -> bool;
+fn number(r: &Value, key: &str, default: f32) -> f32 { r[key].as_f64().map_or(default, |n| n as f32) }
+fn matrix_field(r: &Value, key: &str) -> Result<[f32; 6], String> {
+    if r[key].is_null() { return Ok(canvas::identity()); }
+    let m: [f32; 6] = serde_json::from_value(r[key].clone()).map_err(|e| e.to_string())?;
+    if !m.iter().all(|n| n.is_finite()) { return Err("Nonfinite Canvas transform".into()); }
+    Ok(m)
+}
+fn mapped(m: [f32; 6], x: f32, y: f32) -> (f32, f32) { (m[0]*x+m[2]*y+m[4], m[1]*x+m[3]*y+m[5]) }
+fn transformed(commands: &[PathCommand], m: [f32; 6]) -> Vec<PathCommand> {
+    commands.iter().map(|c| match *c {
+        PathCommand::M { x, y } => { let (x,y)=mapped(m,x,y); PathCommand::M{x,y} },
+        PathCommand::L { x, y } => { let (x,y)=mapped(m,x,y); PathCommand::L{x,y} },
+        PathCommand::Q { x1,y1,x,y } => { let (x1,y1)=mapped(m,x1,y1);let (x,y)=mapped(m,x,y);PathCommand::Q{x1,y1,x,y} },
+        PathCommand::C { x1,y1,x2,y2,x,y } => { let (x1,y1)=mapped(m,x1,y1);let (x2,y2)=mapped(m,x2,y2);let (x,y)=mapped(m,x,y);PathCommand::C{x1,y1,x2,y2,x,y} },
+        PathCommand::Z => PathCommand::Z,
+    }).collect()
+}
+fn stroke(r: &Value) -> Result<Stroke, String> {
+    let mut dash: Vec<f32> = if r["dash"].is_null() { Vec::new() } else { serde_json::from_value(r["dash"].clone()).map_err(|e| e.to_string())? };
+    if dash.iter().any(|n| !n.is_finite() || *n < 0.) { return Err("Invalid Canvas line dash".into()); }
+    if dash.len()%2 == 1 { dash.extend_from_within(..); }
+    if dash.iter().all(|n| *n == 0.) { dash.clear(); }
+    Ok(Stroke {
+        width: number(r,"line_width",1.), miter_limit: number(r,"miter_limit",10.),
+        line_cap: match r["line_cap"].as_str() { Some("round")=>LineCap::Round, Some("square")=>LineCap::Square, _=>LineCap::Butt },
+        line_join: match r["line_join"].as_str() { Some("round")=>LineJoin::Round, Some("bevel")=>LineJoin::Bevel, _=>LineJoin::Miter },
+        dash: if dash.is_empty() { None } else { Some(StrokeDash::new(dash,number(r,"dash_offset",0.)).ok_or("Invalid Canvas line dash")?) },
+    })
+}
+impl Canvas {
+    fn move_to(&mut self,x:f32,y:f32) { let (x,y)=mapped(self.state.transform,x,y);self.path.push(PathCommand::M{x,y}); }
+    fn line_to(&mut self,x:f32,y:f32) { if self.path.is_empty() { self.move_to(x,y); } else { let (x,y)=mapped(self.state.transform,x,y);self.path.push(PathCommand::L{x,y}); } }
+    fn rect_path(&mut self,x:f32,y:f32,w:f32,h:f32) { self.move_to(x,y);self.line_to(x+w,y);self.line_to(x+w,y+h);self.line_to(x,y+h);self.path.push(PathCommand::Z); }
+    fn current(&self) -> Option<(f32,f32)> {
+        let mut current=None;let mut start=None;
+        for c in &self.path { match *c {
+            PathCommand::M{x,y}=>{current=Some((x,y));start=current;},
+            PathCommand::L{x,y}|PathCommand::Q{x,y,..}|PathCommand::C{x,y,..}=>current=Some((x,y)),
+            PathCommand::Z=>current=start,
+        }} current
+    }
+    fn arc(&mut self,cx:f32,cy:f32,rx:f32,ry:f32,rotation:f32,start:f32,end:f32,ccw:bool) -> Result<(),String> {
+        if rx<0. || ry<0. { return Err("Negative arc radius".into()); }
+        let tau=std::f32::consts::TAU;let delta=end-start;
+        let delta=if ccw { if delta<=-tau {-tau} else {-(-delta).rem_euclid(tau)} } else if delta>=tau {tau} else {delta.rem_euclid(tau)};
+        let (s,c)=rotation.sin_cos();let p=|a:f32| {let (sa,ca)=a.sin_cos();(cx+rx*ca*c-ry*sa*s,cy+rx*ca*s+ry*sa*c)};
+        let derivative=|a:f32| {let (sa,ca)=a.sin_cos();(-rx*sa*c-ry*ca*s,-rx*sa*s+ry*ca*c)};
+        let (x,y)=p(start);self.line_to(x,y);
+        let steps=(delta.abs()/std::f32::consts::FRAC_PI_2).ceil() as usize;
+        for i in 0..steps {
+            let a=start+delta*i as f32/steps as f32;let b=start+delta*(i+1) as f32/steps as f32;
+            let k=4./3.*((b-a)/4.).tan();let (ax,ay)=p(a);let (bx,by)=p(b);let (adx,ady)=derivative(a);let (bdx,bdy)=derivative(b);
+            let (x1,y1)=mapped(self.state.transform,ax+k*adx,ay+k*ady);let (x2,y2)=mapped(self.state.transform,bx-k*bdx,by-k*bdy);let (x,y)=mapped(self.state.transform,bx,by);
+            self.path.push(PathCommand::C{x1,y1,x2,y2,x,y});
+        } Ok(())
+    }
+    fn selected_path(&self,r:&Value) -> Result<Vec<PathCommand>,String> {
+        if r["path"].is_null() { return Ok(self.path.clone()); }
+        let path:Vec<PathCommand>=serde_json::from_value(r["path"].clone()).map_err(|e|e.to_string())?;
+        let local=matrix_field(r,"path_transform")?;
+        let m=canvas::matrix(self.state.transform).pre_concat(canvas::matrix(local));
+        Ok(transformed(&path,[m.sx,m.ky,m.kx,m.sy,m.tx,m.ty]))
+    }
+    fn request(&self,r:&Value,kind:&str,path:Vec<PathCommand>) -> Result<CanvasDrawRequest,String> {
+        let color=if r["color"].is_null() {[0,0,0,255]} else {serde_json::from_value(r["color"].clone()).map_err(|e|e.to_string())?};
+        let gradient=&r["gradient"];
+        let paint=CanvasPaint {color,kind:gradient["kind"].as_str().map(str::to_owned),
+            stops:if gradient["stops"].is_null(){Vec::new()}else{serde_json::from_value(gradient["stops"].clone()).map_err(|e|e.to_string())?},
+            points:if gradient["coords"].is_null(){[0.;6]}else{serde_json::from_value(gradient["coords"].clone()).map_err(|e|e.to_string())?},
+            transform:matrix_field(gradient,"transform")?};
+        let style=stroke(r)?;
+        let dash=if r["dash"].is_null(){Vec::new()}else{let mut d:Vec<f32>=serde_json::from_value(r["dash"].clone()).map_err(|e|e.to_string())?;if d.len()%2==1{d.extend_from_within(..);}if d.iter().all(|n|*n==0.){d.clear();}d};
+        Ok(CanvasDrawRequest {width:self.width,height:self.height,path,kind:kind.into(),paint,
