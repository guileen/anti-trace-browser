+    try testing.expectEqualSlices(u8, "image/x-icon", icon.mime);
+    try ctx.processMessage(.{ .id = 405, .method = "Runtime.evaluate", .sessionId = "SID-X", .params = .{
+        .expression = "document.querySelector('#site-icon').href = 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mPQKDryHwAEggJefd/xlgAAAABJRU5ErkJggg=='",
