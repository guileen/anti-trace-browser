+  const program=gl.createProgram(),shader=gl.createShader(gl.FRAGMENT_SHADER);
+  testing.expectEqual(true,gl.isProgram(program));
+  testing.expectEqual(true,gl.isShader(shader));
+  testing.expectEqual(false,other.isProgram(program));
+  testing.expectEqual(gl.NO_ERROR,other.getError());
+  let wrongType=false;
+  try{gl.isProgram(shader);}catch(error){wrongType=error instanceof TypeError;}
+  testing.expectEqual(true,wrongType);
+  other.deleteProgram(program);
+  testing.expectEqual(gl.INVALID_OPERATION,other.getError());
+  testing.expectEqual(true,gl.isProgram(program));
+  const buffer=gl.createBuffer();
+  testing.expectEqual(false,gl.isBuffer(buffer));
+  gl.bindBuffer(gl.ARRAY_BUFFER,buffer);
+  testing.expectEqual(true,gl.isBuffer(buffer));
+  const texture=gl.createTexture();
+  testing.expectEqual(false,gl.isTexture(texture));
+  gl.bindTexture(gl.TEXTURE_2D,texture);
+  testing.expectEqual(true,gl.isTexture(texture));
+  const framebuffer=gl.createFramebuffer();
+  testing.expectEqual(false,gl.isFramebuffer(framebuffer));
+  gl.bindFramebuffer(gl.FRAMEBUFFER,framebuffer);
+  testing.expectEqual(true,gl.isFramebuffer(framebuffer));
+  const renderbuffer=gl.createRenderbuffer();
+  testing.expectEqual(false,gl.isRenderbuffer(renderbuffer));
+  gl.bindRenderbuffer(gl.RENDERBUFFER,renderbuffer);
+  testing.expectEqual(true,gl.isRenderbuffer(renderbuffer));
+  gl.attachShader(program,shader);
+  gl.deleteShader(shader);
+  testing.expectEqual(true,gl.isShader(shader));
+  gl.deleteProgram(program);gl.deleteProgram(program);gl.deleteProgram(null);
+  testing.expectEqual(false,gl.isShader(shader));
+  gl.deleteBuffer(buffer);gl.deleteTexture(texture);gl.deleteFramebuffer(framebuffer);gl.deleteRenderbuffer(renderbuffer);
+  testing.expectEqual(false,gl.isProgram(program));
+  testing.expectEqual(false,gl.isBuffer(buffer));
+  testing.expectEqual(false,gl.isTexture(texture));
+  testing.expectEqual(false,gl.isFramebuffer(framebuffer));
+  testing.expectEqual(false,gl.isRenderbuffer(renderbuffer));
+  const replacement=gl.createProgram();
+  testing.expectEqual(true,gl.isProgram(replacement));
+  testing.expectEqual(false,gl.isProgram(program));
+  gl.deleteProgram(replacement);
+  testing.expectEqual(gl.NO_ERROR,gl.getError());
+  gl.enable(-1);testing.expectEqual(gl.INVALID_ENUM,gl.getError());
