+/// Restore the profile before it can publish ready. Legacy JSON is imported
+/// only when the durable database does not yet exist; failures are never ignored.
+pub fn restoreProfile(jar: *Cookie.Jar, data_dir: []const u8) !void {
+    const path = try jar.allocator.printSentinel("{s}/cookies.sqlite", .{data_dir}, 0);
+    defer jar.allocator.free(path);
+    const exists = if (std.Io.Dir.cwd().statFile(lp.io, path, .{})) |_| true else |err| switch (err) {
+        error.FileNotFound => false,
+        else => return err,
+    };
+    if (!exists) {
+        const legacy_path = try std.fs.path.join(jar.allocator, &.{ data_dir, "cookies.json" });
+        defer jar.allocator.free(legacy_path);
+        const content: ?[]u8 = std.Io.Dir.cwd().readFileAlloc(lp.io, legacy_path, jar.allocator, .limited(16 * 1024 * 1024)) catch |err| switch (err) {
+            error.FileNotFound => null,
+            else => return err,
+        };
+        if (content) |bytes| {
+            defer jar.allocator.free(bytes);
+            const parsed = std.json.parseFromSlice([]const JsonCookie, jar.allocator, bytes, .{ .ignore_unknown_fields = true }) catch |err| switch (err) {
+                error.OutOfMemory => return err,
+                else => return error.incompatible_profile,
+            };
+            defer parsed.deinit();
+            const now = lp.datetime.timestamp(.real);
+            for (parsed.value) |jc| {
+                if (jc.domain.len == 0) return error.incompatible_profile;
+                if (jc.path) |p| {
+                    if (p.len == 0 or p[0] != '/') return error.incompatible_profile;
+                }
+                if (jc.expires) |e| if (!std.math.isFinite(e)) return error.incompatible_profile;
+                if (jc.sameSite) |s| if (Cookie.SameSite.parse(s) == null) return error.incompatible_profile;
+                const cookie = try jc.toCookie(jar.allocator);
+                try jar.add(cookie, now, true);
+            }
+        }
+    }
+    try jar.openPersistent(path);
+}
