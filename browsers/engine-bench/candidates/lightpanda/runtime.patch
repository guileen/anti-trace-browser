+<script id="native_object_liveness_and_deletion">
+{
+  const canvas=document.createElement('canvas');canvas.width=2;canvas.height=2;
+  const gl=canvas.getContext('webgl');
+  const other=document.createElement('canvas').getContext('webgl');
+  for(const method of ['isProgram','isShader','isBuffer','isTexture','isFramebuffer','isRenderbuffer']){
+    testing.expectEqual(false,gl[method](null));
