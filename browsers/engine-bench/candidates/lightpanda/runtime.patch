+test "cdp.input: Unicode range replacement keeps input and textarea carets in UTF16 units" {
+    var ctx = try testing.context();
+    defer ctx.deinit();
+    const bc = try ctx.loadBrowserContext(.{ .url = "mcp_actions.html" });
+    const frame = bc.mainFrame().?;
+    var ls: lp.js.Local.Scope = undefined;
+    frame.js.localScope(&ls);
+    defer ls.deinit();
+
+    _ = try ls.local.compileAndRun(
+        \\window.arm = tag => {
+        \\  document.body.innerHTML = '';
+        \\  window.ctl = document.createElement(tag);
+        \\  document.body.appendChild(ctl);
+        \\  ctl.value = 'A😀中文Z'; ctl.focus(); ctl.setSelectionRange(3, 5);
+        \\};
+    , null);
+    var id: u32 = 1;
+    for ([_][:0]const u8{ "arm('input')", "arm('textarea')" }) |setup| {
+        _ = try ls.local.compileAndRun(setup, null);
+        try ctx.processMessage(.{ .id = id, .method = "Input.insertText", .params = .{ .text = "é😀" } });
+        id += 1;
+        try testing.expect((try ls.local.compileAndRun(
+            \\ctl.value === 'A😀é😀Z' && ctl.selectionStart === 6 && ctl.selectionEnd === 6
+        , null)).isTrue());
+        for ([_][]const u8{ "ArrowLeft", "Backspace", "Delete" }) |key| {
+            try ctx.processMessage(.{ .id = id, .method = "Input.dispatchKeyEvent", .params = .{
+                .type = "rawKeyDown",
+                .key = key,
+                .code = key,
+            } });
+            id += 1;
+        }
+        try testing.expect((try ls.local.compileAndRun(
+            \\ctl.value === 'A😀Z' && ctl.selectionStart === 3 && ctl.selectionEnd === 3
+        , null)).isTrue());
+
+        // Property setters must collapse or extend the other edge, never
+        // leave an inverted byte range for the native replacement to slice.
+        _ = try ls.local.compileAndRun(
+            \\ctl.value = 'A😀中文Z'; ctl.setSelectionRange(1, 3);
+            \\ctl.selectionStart = 4;
+        , null);
+        try testing.expect((try ls.local.compileAndRun("ctl.selectionStart === 4 && ctl.selectionEnd === 4", null)).isTrue());
+        _ = try ls.local.compileAndRun("ctl.selectionEnd = 1", null);
+        try ctx.processMessage(.{ .id = id, .method = "Input.insertText", .params = .{ .text = "文" } });
+        id += 1;
+        try testing.expect((try ls.local.compileAndRun(
+            \\ctl.value === 'A文😀中文Z' && ctl.selectionStart === 2 && ctl.selectionEnd === 2
+        , null)).isTrue());
+
+        // preserve shifts by UTF-16 code units, not the replacement's UTF-8 bytes.
+        try testing.expect((try ls.local.compileAndRun(
+            \\ctl.value = 'A😀中文Z'; ctl.setSelectionRange(5, 6);
+            \\ctl.setRangeText('😀', 3, 4, 'preserve');
+            \\ctl.value === 'A😀😀文Z' && ctl.selectionStart === 6 && ctl.selectionEnd === 7
+        , null)).isTrue());
+
+        _ = try ls.local.compileAndRun("ctl.value = 'a中文z'; ctl.setSelectionRange(1, 1)", null);
+        try ctx.processMessage(.{ .id = id, .method = "Input.insertText", .params = .{ .text = "\r\né" } });
+        id += 1;
+        try testing.expect((try ls.local.compileAndRun(
+            \\ctl.tagName === 'INPUT'
+            \\  ? ctl.value === 'aé中文z' && ctl.selectionStart === 2 && ctl.selectionEnd === 2
+            \\  : ctl.value === 'a\né中文z' && ctl.selectionStart === 3 && ctl.selectionEnd === 3
+        , null)).isTrue());
+        // The next edit must use that normalized edge, not split 中's UTF-8.
+        try ctx.processMessage(.{ .id = id, .method = "Input.insertText", .params = .{ .text = "X" } });
+        id += 1;
+        try testing.expect((try ls.local.compileAndRun(
+            \\ctl.tagName === 'INPUT' ? ctl.value === 'aéX中文z' : ctl.value === 'a\néX中文z'
+        , null)).isTrue());
+    }
+}
