+fn fileSha256Hex(path: []const u8, minimum_bytes: u64) ![64]u8 {
+    const file = try std.Io.Dir.cwd().openFile(lp.io, path, .{});
+    defer file.close(lp.io);
+    var buffer: [64 * 1024]u8 = undefined;
+    var reader = file.reader(lp.io, &buffer);
+    var hash = std.crypto.hash.sha2.Sha256.init(.{});
+    var count: u64 = 0;
+    while (true) {
+        const bytes = reader.interface.peekGreedy(1) catch |err| switch (err) {
+            error.EndOfStream => break,
+            else => return err,
+        };
+        if (bytes.len > max_native_asset_bytes - count) return error.StreamTooLong;
+        count += bytes.len;
+        hash.update(bytes);
+        reader.interface.toss(bytes.len);
+    }
+    if (count < minimum_bytes) return error.invalid_config;
+    var digest: [32]u8 = undefined;
+    hash.final(&digest);
+    return std.fmt.bytesToHex(digest, .lower);
